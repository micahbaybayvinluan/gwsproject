enum ChargeKind {
  INVENTORY_DISCREPANCY
  EXPIRED
  DAMAGED
  CASH_SHORTAGE
  OTHER
}

model ChargeForm {
  id                       String     @id @default(uuid())
  controlNo                String     @unique @map("control_no")
  /// What the charge is for; set automatically by the source document (write-off, daily close, count) or chosen for manual forms.
  kind                     ChargeKind @default(INVENTORY_DISCREPANCY)
  sourceType               String?    @map("source_type") // ExpiryWriteoffDoc | DailyClose | DiscrepancyCase
  sourceId                 String?    @map("source_id")
  locationId               String     @map("location_id")
  discrepancyCaseId        String?    @map("discrepancy_case_id")
  reason                   String? // for manual charge forms
  totalAmount              Decimal    @default(0) @map("total_amount") @db.Decimal(14, 2)
  finalizedByHrAt          DateTime?  @map("finalized_by_hr_at")
  finalizedBy              String?    @map("finalized_by")
  payrollDeductionSchedule Json?      @map("payroll_deduction_schedule") // [{employeeId, periods, perPeriod}]
  createdAt                DateTime   @default(now()) @map("created_at")
  createdBy                String?    @map("created_by")
  updatedAt                DateTime   @updatedAt @map("updated_at")

