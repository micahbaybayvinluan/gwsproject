  qty          Int
  unitCharge   Decimal  @map("unit_charge") @db.Decimal(14, 2) // franchise-tier price in effect
  batchCost    Decimal? @map("batch_cost") @db.Decimal(14, 2) // for R11 (never serialized to HR)
  amount       Decimal  @db.Decimal(14, 2)

  chargeForm ChargeForm @relation(fields: [chargeFormId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id])

  @@map("charge_form_lines")
}

model ChargeFormAllocation {
  id             String    @id @default(uuid())
  chargeFormId   String    @map("charge_form_id")
