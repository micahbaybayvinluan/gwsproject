// GWS-ERP Prisma schema — single data model for Phase 1 (operations) and Phase 2 (finance).
// Money: Decimal(14,2). Quantities: Int. Timestamps stored UTC; business dates computed in Asia/Manila.
// No hard deletes on transactional tables: voided_at / voided_by / void_reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Organisation ─────────────────────────────

enum LocationType {
  WAREHOUSE
  BRANCH
  FRANCHISE
  OFFICE
  CONSIGNEE
  VIRTUAL
}

model Location {
  id                         String       @id @default(uuid())
  code                       String       @unique
  /// 2-letter code printed first on every form number of this location, e.g. WA-PO-000012 (West Ave pull-out no. 12)
  shortCode                  String?      @unique @map("short_code")
  name                       String
  type                       LocationType
  isSelling                  Boolean      @default(false) @map("is_selling")
  franchiseOwnerUserId       String?      @map("franchise_owner_user_id")
  /// Franchise owner's choice: may the franchise associate confirm incoming transfers (the owner is then only notified)?
  franchiseAssociateReceives Boolean      @default(false) @map("franchise_associate_receives")
  // days allowed to deposit a day's cash sales (set by the Head Auditor or Admin)
  cashDepositMaxDays         Int          @default(1) @map("cash_deposit_max_days")
  address                    String?
  active                     Boolean      @default(true)
  createdAt                  DateTime     @default(now()) @map("created_at")
  createdBy                  String?      @map("created_by")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  updatedBy                  String?      @map("updated_by")

  franchiseOwner    User?                    @relation("FranchiseOwner", fields: [franchiseOwnerUserId], references: [id])
  assignments       UserLocationAssignment[]
  stockLedger       StockLedger[]
  stockBalances     StockBalance[]
  minStockLevels    MinStockLevel[]
  receivingDocs     ReceivingDoc[]
  transfersFrom     TransferDoc[]            @relation("TransferFrom")
  transfersTo       TransferDoc[]            @relation("TransferTo")
  salesDocs         SalesDoc[]
  expenseDocs       ExpenseDoc[]
  countDocs         CountDoc[]
  chargeForms       ChargeForm[]
  writeoffDocs      ExpiryWriteoffDoc[]
  consignmentsOut   ConsignmentAgreement[]   @relation("ConsigneeLocation")
  riders            Rider[]
  agents            Agent[]
  accounts          Account[]
  dailyCloses       DailyClose[]
  cashFund          CashFund?
  storeInspections  StoreInspection[]
  franchiseExpenses FranchiseExpense[]
  employees         Employee[]
  /// franchise on cash-before-delivery after unpaid accounts (memo 2026-07-31)
  creditHold        Boolean                  @default(false) @map("credit_hold")
  creditHoldNote    String?                  @map("credit_hold_note")

  @@map("locations")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // ADMIN, HEAD_AUDITOR, ...
  name        String
  description String?
  permissions Json // string[] of permission keys
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id                       String    @id @default(uuid())
  username                 String    @unique
  email                    String    @unique
  fullName                 String    @map("full_name")
  roleId                   String    @map("role_id")
  passwordHash             String    @map("password_hash")
  totpSecret               String?   @map("totp_secret")
  totpEnabled              Boolean   @default(false) @map("totp_enabled")
  active                   Boolean   @default(true)
  mustChangePassword       Boolean   @default(true) @map("must_change_password")
  /// Company ID number of the one person this account belongs to (accounts are personal, never shared).
  idNumber                 String?   @unique @map("id_number")
  /// When the person accepted the accountability statement ("this account is mine; everything done under it is my responsibility").
  accountabilityAcceptedAt DateTime? @map("accountability_accepted_at")
  accountabilityIp         String?   @map("accountability_ip")
  emailDigest              Boolean   @default(true) @map("email_digest")
  lastLoginAt              DateTime? @map("last_login_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  createdBy                String?   @map("created_by")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  updatedBy                String?   @map("updated_by")

  role                Role                     @relation(fields: [roleId], references: [id])
  assignments         UserLocationAssignment[]
  permissionOverrides UserPermissionOverride[]
  ownedFranchises     Location[]               @relation("FranchiseOwner")
  notifications       Notification[]
  approvalDecisions   ApprovalDecision[]
  auditLogs           AuditLog[]
  employee            Employee?

  @@map("users")
}

model UserLocationAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@map("user_location_assignments")
}

model UserPermissionOverride {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  permissionKey String   @map("permission_key")
  granted       Boolean // true = grant, false = revoke
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@map("user_permission_overrides")
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique // SUP-001 — visible to everyone
  name        String // Admin / Head Auditor / External Auditor only (redacted otherwise)
  contact     String?
  termsDays   Int      @default(0) @map("terms_days")
  apAccountId String?  @map("ap_account_id")
  isConsignor Boolean  @default(false) @map("is_consignor")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  apAccount      Account?               @relation(fields: [apAccountId], references: [id])
  products       Product[]
  batches        Batch[]
  receivingDocs  ReceivingDoc[]
  consignmentsIn ConsignmentAgreement[] @relation("ConsignorSupplier")

  @@map("suppliers")
}

enum AccountingClass {
  SUPPLEMENT
  FREEBIE
  PLASTIC
  APPAREL
  EQUIPMENT
  OTHER
  REPACKED
  BUNDLE
}

model Category {
  id              String          @id @default(uuid())
  name            String          @unique
  accountingClass AccountingClass @map("accounting_class")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  barcode          String?  @unique
  name             String
  /// days a customer takes to finish one unit (e.g. 30 servings = 30); drives the re-order reminder to the store
  consumptionDays  Int?     @map("consumption_days")
  categoryId       String   @map("category_id")
  brand            String?
  unit             String   @default("pc")
  /// flavors this SKU comes in (owner request 2026-09-30); receiving suggests them and adds new ones
  flavors          String[] @default([])
  supplierId       String?  @map("supplier_id")
  trackExpiry      Boolean  @default(true) @map("track_expiry")
  active           Boolean  @default(true)
  isBundle         Boolean  @default(false) @map("is_bundle")
  franchiseVisible Boolean  @default(true) @map("franchise_visible")
  needsReview      Boolean  @default(false) @map("needs_review") // flagged by import keyword map
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  category             Category              @relation(fields: [categoryId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  bundleComponents     BundleComponent[]     @relation("BundleParent")
  componentOf          BundleComponent[]     @relation("BundleChild")
  prices               PriceList[]
  costs                ProductCost[]
  minStockLevels       MinStockLevel[]
  batches              Batch[]
  stockLedger          StockLedger[]
  stockBalances        StockBalance[]
  receivingLines       ReceivingLine[]
  transferLines        TransferLine[]
  salesLines           SalesLine[]
  countLines           CountLine[]
  chargeFormLines      ChargeFormLine[]
  writeoffLines        ExpiryWriteoffLine[]
  priceChangeLines     PriceChangeLine[]
  consignmentSaleLines ConsignmentSaleLine[]

  @@index([name])
  @@map("products")
}

model BundleComponent {
  id                 String @id @default(uuid())
  bundleProductId    String @map("bundle_product_id")
  componentProductId String @map("component_product_id")
  qty                Int

  bundle    Product @relation("BundleParent", fields: [bundleProductId], references: [id])
  component Product @relation("BundleChild", fields: [componentProductId], references: [id])

  @@unique([bundleProductId, componentProductId])
  @@map("bundle_components")
}

model PriceTier {
  id        String   @id @default(uuid())
  key       String   @unique // RETAIL, DEALER, FRANCHISE, AGENT, WHOLESALE, OTHER_1...
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("price_tiers")
}

model PriceList {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  tier          String // PriceTier.key
  effectiveFrom DateTime @map("effective_from") @db.Date
  price         Decimal  @db.Decimal(14, 2)
  approvedBy    String?  @map("approved_by")
  sourceDocId   String?  @map("source_doc_id")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, tier, effectiveFrom])
  @@index([productId, tier])
  @@map("price_lists")
}

model ProductCost {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  cost          Decimal  @db.Decimal(14, 2)
  approvedBy    String?  @map("approved_by")
  sourceDocId   String?  @map("source_doc_id")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, effectiveFrom])
  @@map("product_costs")
}

model MinStockLevel {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  minQty     Int      @map("min_qty")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("min_stock_levels")
}

// ───────────────────────────── Stock ─────────────────────────────

model Batch {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  batchNo          String?   @map("batch_no")
  expiryDate       DateTime? @map("expiry_date") @db.Date
  /// flavor of this batch (owner request 2026-09-30): a SKU is one item; its flavors are told apart per batch, like expiry
  flavor           String?
  receivedRef      String?   @map("received_ref") // receiving doc id / opening stock ref
  unitCost         Decimal   @map("unit_cost") @db.Decimal(14, 2)
  originalUnitCost Decimal?  @map("original_unit_cost") @db.Decimal(14, 2) // kept when revalued (R12)
  supplierId       String?   @map("supplier_id")
  isConsignmentIn  Boolean   @default(false) @map("is_consignment_in")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  product       Product              @relation(fields: [productId], references: [id])
  supplier      Supplier?            @relation(fields: [supplierId], references: [id])
  ledger        StockLedger[]
  balances      StockBalance[]
  transferLines TransferLine[]
  salesLines    SalesLine[]
  writeoffLines ExpiryWriteoffLine[]
  revaluations  RevaluationLine[]

  @@index([productId, expiryDate])
  @@map("batches")
}

enum MovementType {
  RECEIVE
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_RETURN
  RETURN_TO_WAREHOUSE
  RETURN_TO_SUPPLIER
  CONSIGN_OUT
  CONSIGN_SALE
  CONSIGN_RETURN
  ADJUST_COUNT
  EXPIRED_WRITEOFF
  FREEBIE_ISSUE
  TASTING
  BUNDLE_BUILD
  BUNDLE_BREAK
  /// the replacement handed to a customer against a replacement ticket
  REPLACEMENT_OUT
}

model StockLedger {
  id           String       @id @default(uuid())
  locationId   String       @map("location_id")
  productId    String       @map("product_id")
  batchId      String       @map("batch_id")
  qtyDelta     Int          @map("qty_delta")
  movementType MovementType @map("movement_type")
  documentType String       @map("document_type")
  documentId   String       @map("document_id")
  unitCost     Decimal      @map("unit_cost") @db.Decimal(14, 2) // batch cost at time of movement
  postedAt     DateTime     @default(now()) @map("posted_at")
  businessDate DateTime     @map("business_date") @db.Date // Manila calendar date
  createdBy    String?      @map("created_by")

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([locationId, productId])
  @@index([documentType, documentId])
  @@index([businessDate])
  @@map("stock_ledger")
}

model StockBalance {
  locationId String   @map("location_id")
  productId  String   @map("product_id")
  batchId    String   @map("batch_id")
  qty        Int
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@id([locationId, productId, batchId])
  @@index([locationId, productId])
  @@map("stock_balances")
}

// ───────────────────────────── Documents ─────────────────────────────

enum DocStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  VOIDED
}

/// A form number freed when a draft was deleted and could not be closed up by renumbering later drafts; the next new form of that kind takes the lowest one (owner request 2026-10-01: form numbers adjust by themselves)
model FormNumberReleased {
  id        String   @id @default(uuid())
  docType   String   @map("doc_type")
  scopeKey  String   @map("scope_key")
  no        Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([docType, scopeKey, no])
  @@map("form_numbers_released")
}

model ControlSequence {
  id       String @id @default(uuid())
  docType  String @map("doc_type")
  scopeKey String @default("") @map("scope_key") // location id or '' (NULLs would defeat ON CONFLICT)
  year     Int    @default(0)
  nextNo   Int    @default(1) @map("next_no")

  @@unique([docType, scopeKey, year])
  @@map("control_sequences")
}

model Attachment {
  id           String   @id @default(uuid())
  documentType String   @map("document_type")
  documentId   String   @map("document_id")
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key")
  sha256       String
  scanStatus   String   @default("CLEAN") @map("scan_status") // CLEAN | SKIPPED | INFECTED
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([documentType, documentId])
  @@map("attachments")
}

model ReceivingDoc {
  id                  String    @id @default(uuid())
  controlNo           String    @map("control_no")
  docDate             DateTime  @map("doc_date") @db.Date
  status              DocStatus @default(DRAFT)
  locationId          String    @map("location_id")
  supplierId          String    @map("supplier_id")
  /// this delivery replaces items we returned to the supplier (ticket RT-…); its arrival closes the ticket
  replacementTicketId String?   @map("replacement_ticket_id")
  /// this delivery is for a purchase order (PO-…); its arrival updates the order and tells the branches
  purchaseOrderId     String?   @map("purchase_order_id")
  supplierRef         String?   @map("supplier_ref")
  isConsignmentIn     Boolean   @default(false) @map("is_consignment_in")
  /// Warehouse Associate's delivery: the In-Charge checked the goods (first step; the Head Auditor then approves the cost)
  goodsCheckedBy      String?   @map("goods_checked_by")
  goodsCheckedAt      DateTime? @map("goods_checked_at")
  paidOnReceipt       Boolean   @default(false) @map("paid_on_receipt")
  paymentAccountId    String?   @map("payment_account_id")
  notes               String?
  preparedBy          String    @map("prepared_by")
  approvalRequestId   String?   @map("approval_request_id")
  postedAt            DateTime? @map("posted_at")
  voidedAt            DateTime? @map("voided_at")
  voidedBy            String?   @map("voided_by")
  voidReason          String?   @map("void_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by")

  location Location        @relation(fields: [locationId], references: [id])
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  lines    ReceivingLine[]

  @@unique([locationId, controlNo])
  @@map("receiving_docs")
}

model ReceivingLine {
  id            String    @id @default(uuid())
  docId         String    @map("doc_id")
  productId     String    @map("product_id")
  qty           Int
  freeQty       Int       @default(0) @map("free_qty")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  batchNo       String?   @map("batch_no")
  flavor        String?
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(14, 2) // entered by Head Auditor; hidden from warehouse roles
  costUnchanged Boolean   @default(false) @map("cost_unchanged")
  isNewProduct  Boolean   @default(false) @map("is_new_product")
  batchId       String?   @map("batch_id")
  remarks       String?

  doc     ReceivingDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("receiving_lines")
}

enum TransferType {
  RESTOCK
  RETURN
  REPLACEMENT
  CONSIGNMENT_OUT
  CONSIGNMENT_RETURN
  INTERNAL
  /// E-commerce pull-out: warehouse → the platform's "with courier" holding place (TikTok / Shopee / Lazada); the In-Charge approves
  ECOMMERCE
  /// Stock given out to Prothin Marketing / GWS Marketing, or bad orders (BO): the Head Auditor approves, it can be endorsed to Accounting as an expense
  MARKETING_PULLOUT
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED // stock moved to IN_TRANSIT
  REJECTED
  RECEIVED // fully confirmed
  DISCREPANCY // received with shortfall pending Head Auditor resolution
  RESOLVED
  VOIDED
}

model TransferDoc {
  id                String         @id @default(uuid())
  /// Goods into the warehouse confirmed by a Warehouse Associate wait for the In-Charge (lines as confirmed).
  pendingReceipt    Json?          @map("pending_receipt")
  pendingReceiptBy  String?        @map("pending_receipt_by")
  /// Marketing / BO pull-outs: endorsed to Accounting as an expense (PENDING → POSTED, or REJECTED)
  endorseExpense    Boolean        @default(false) @map("endorse_expense")
  expenseStatus     String?        @map("expense_status")
  expenseAt         DateTime?      @map("expense_at")
  expenseBy         String?        @map("expense_by")
  /// the receiving location's own number for the same document (Transfer-In), e.g. MY-TI-000003
  transferInNo      String?        @unique @map("transfer_in_no")
  controlNo         String         @map("control_no")
  docDate           DateTime       @map("doc_date") @db.Date
  status            TransferStatus @default(DRAFT)
  fromLocationId    String         @map("from_location_id")
  toLocationId      String         @map("to_location_id")
  transferType      TransferType   @map("transfer_type")
  returnReason      String?        @map("return_reason") // clumped, damaged, wrong item, expired
  notes             String?
  preparedBy        String         @map("prepared_by")
  approvalRequestId String?        @map("approval_request_id")
  approvedAt        DateTime?      @map("approved_at")
  receivedBy        String?        @map("received_by")
  receivedAt        DateTime?      @map("received_at")
  discrepancyCaseId String?        @map("discrepancy_case_id")
  voidedAt          DateTime?      @map("voided_at")
  voidedBy          String?        @map("voided_by")
  voidReason        String?        @map("void_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  createdBy         String?        @map("created_by")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  updatedBy         String?        @map("updated_by")

  fromLocation Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        TransferLine[]

  @@unique([fromLocationId, controlNo])
  @@index([toLocationId, status])
  @@map("transfer_docs")
}

model TransferLine {
  id                  String  @id @default(uuid())
  docId               String  @map("doc_id")
  productId           String  @map("product_id")
  batchId             String  @map("batch_id")
  qtySent             Int     @map("qty_sent")
  qtyReceived         Int?    @map("qty_received")
  checkerRemarks      String? @map("checker_remarks")
  discrepancyNote     String? @map("discrepancy_note")
  shortfallResolution String? @map("shortfall_resolution") // TO_SENDER | TO_RECEIVER | WRITEOFF

  doc     TransferDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  batch   Batch       @relation(fields: [batchId], references: [id])

  @@map("transfer_lines")
}

enum SalesChannel {
  WALK_IN
  DELIVERY
  SHIPPING_COURIER
  SHIPPING_MARKETPLACE
  FRANCHISE
  DEALER
  AGENT
  PERSONAL
  OTHER
}

enum PaymentMode {
  CASH
  ONLINE
  CREDIT_CARD
  AR_PDC
}

enum CustomerType {
  DEALER
  FRANCHISE
  AGENT
  CONSIGNEE
  CUSTOMER
}

model Customer {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        CustomerType
  locationId  String?      @map("location_id") // FRANCHISE/CONSIGNEE customers map to a Location
  agentId     String?      @map("agent_id")
  arAccountId String?      @map("ar_account_id")
  contact     String?
  phone       String?
  address     String?
  email       String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  arAccount  Account?   @relation(fields: [arAccountId], references: [id])
  salesDocs  SalesDoc[]
  arPayments Payment[]

  @@map("customers")
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  /// the Agent's own user account (role Agent): sees this agent's sales at every branch
  userId      String?  @map("user_id")
  locationId  String   @map("location_id")
  onPayroll   Boolean  @default(false) @map("on_payroll")
  defaultTier String   @default("AGENT") @map("default_tier")
  employeeId  String?  @map("employee_id")
  arAccountId String?  @map("ar_account_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location  Location   @relation(fields: [locationId], references: [id])
  arAccount Account?   @relation(fields: [arAccountId], references: [id])
  salesDocs SalesDoc[]

  @@map("agents")
}

model Rider {
  id         String   @id @default(uuid())
  name       String
  locationId String   @map("location_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  location  Location   @relation(fields: [locationId], references: [id])
