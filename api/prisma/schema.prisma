  isFreebie        Boolean @default(false) @map("is_freebie")
  lineRemarks      String? @map("line_remarks")
  nearExpiryWarn   Boolean @default(false) @map("near_expiry_warn")
  specialPriceFlag String? @map("special_price_flag") // PENDING | APPROVED | REJECTED

  doc     SalesDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  batch   Batch    @relation(fields: [batchId], references: [id])

  @@map("sales_lines")
}

model Payment {
  id                   String      @id @default(uuid())
  creditNoteNo         String      @unique @map("credit_note_no")
  customerId           String?     @map("customer_id")
  amount               Decimal     @db.Decimal(14, 2)
  discount             Decimal     @default(0) @db.Decimal(14, 2)
  paymentMode          PaymentMode @map("payment_mode")
  paymentAccountId     String?     @map("payment_account_id")
  proofAttachmentId    String?     @map("proof_attachment_id")
  receivedAt           DateTime    @map("received_at")
  businessDate         DateTime    @map("business_date") @db.Date
  notes                String?
  /// POSTED = applied to the invoices; PENDING = entered by a branch, waiting for Accounting approval; REJECTED
  status               String      @default("POSTED")
  approvalRequestId    String?     @map("approval_request_id")
  requestedSalesDocIds String[]    @default([]) @map("requested_sales_doc_ids")
  locationId           String?     @map("location_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  createdBy            String?     @map("created_by")
  voidedAt             DateTime?   @map("voided_at")
  voidedBy             String?     @map("voided_by")
  voidReason           String?     @map("void_reason")

  customer       Customer?           @relation(fields: [customerId], references: [id])
  paymentAccount Account?            @relation(fields: [paymentAccountId], references: [id])
  allocations    PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id         String  @id @default(uuid())
  paymentId  String  @map("payment_id")
  salesDocId String  @map("sales_doc_id")
  amount     Decimal @db.Decimal(14, 2)

  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
