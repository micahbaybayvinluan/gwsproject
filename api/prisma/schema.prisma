  ADVANCES_TO
  FIXED_ASSET
  ACCUM_DEPN
  CURRENT_LIABILITY
  ADVANCES_FROM
  EQUITY
  REVENUE
  DIRECT_COST
  OPEX
  OTHER_INCOME
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum EntryScope {
  BRANCH
  MAIN
  BOTH
}

enum PaymentAccountType {
  CASH_DRAWER
  PETTY_CASH
  BANK
  GCASH
  PLATFORM
  CREDIT_CARD_SETTLEMENT
}

model AccountTemplate {
