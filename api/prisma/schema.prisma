model RevaluationLine {
  id         String  @id @default(uuid())
  entryId    String  @map("entry_id")
  locationId String  @map("location_id")
  batchId    String  @map("batch_id")
  qty        Int
  gain       Decimal @db.Decimal(14, 2)

  entry RevaluationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  batch Batch            @relation(fields: [batchId], references: [id])

  @@map("revaluation_lines")
}

// ───────────────────────────── Approvals, notifications, audit ─────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_APPROVED
  CANCELLED
}

model ApprovalRequest {
  id                      String         @id @default(uuid())
  type                    String // COST_ON_RECEIVING, TRANSFER_INTERNAL, ...
  documentType            String         @map("document_type")
  documentId              String         @map("document_id")
  requestedBy             String         @map("requested_by")
  requiredApproverRoles   String[]       @map("required_approver_roles")
  /// Person-targeted requests (e.g. WAREHOUSE_EDIT: the associate who entered the document must accept the In-Charge's edit). Empty = role routing.
  requiredApproverUserIds String[]       @default([]) @map("required_approver_user_ids")
  anyOf                   Boolean        @default(false) @map("any_of") // true = any one listed role suffices
  status                  ApprovalStatus @default(PENDING)
  summary                 Json? // snapshot shown inline in the inbox
  autoApproveAt           DateTime?      @map("auto_approve_at")
  decidedAt               DateTime?      @map("decided_at")
  discrepancyCaseId       String?        @map("discrepancy_case_id")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  decisions ApprovalDecision[]

  @@index([status, type])
  @@index([documentType, documentId])
  @@map("approval_requests")
}

model ApprovalDecision {
  id        String   @id @default(uuid())
  requestId String   @map("request_id")
  userId    String   @map("user_id")
  roleKey   String   @map("role_key")
  decision  String // APPROVE | REJECT
  note      String?
  decidedAt DateTime @default(now()) @map("decided_at")

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@map("approval_decisions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  emailedAt DateTime? @map("emailed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String // CREATE | UPDATE | VOID | APPROVE | LOGIN | LOGIN_FAILED | EXPORT | PERMISSION_CHANGE ...
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  at         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, at])
  @@map("audit_log")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("settings")
}

model AlertState {
  id         String   @id @default(uuid())
  kind       String // MIN_STOCK | EXPIRY_T6 | EXPIRY_MONTHLY | EXPIRED | AR_OVERDUE
  refKey     String   @map("ref_key") // e.g. `${locationId}:${productId}` or batchId
  lastSentAt DateTime @map("last_sent_at")

  @@unique([kind, refKey])
  @@map("alert_states")
}

// ───────────────────────────── Accounting (Phase 2) ─────────────────────────────

enum AccountClass {
  CASH
  AR
  INVENTORY
  ADVANCES_TO
  FIXED_ASSET
  ACCUM_DEPN
  CURRENT_LIABILITY
  ADVANCES_FROM
  EQUITY
  REVENUE
  DIRECT_COST
  OPEX
  OTHER_INCOME
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum EntryScope {
  BRANCH
  MAIN
  BOTH
}

enum PaymentAccountType {
  CASH_DRAWER
  PETTY_CASH
  BANK
  GCASH
  PLATFORM
  CREDIT_CARD_SETTLEMENT
}

model AccountTemplate {
  id           String       @id @default(uuid())
  key          String       @unique // PETTY_CASH, CASH_ON_HAND, INV_SUPPLEMENTS, SALES_WALK_IN, ...
  titlePattern String       @map("title_pattern") // "Petty Cash – {branch}"
  class        AccountClass
  channelTag   String?      @map("channel_tag")
  entryScope   EntryScope   @default(BRANCH) @map("entry_scope")
  appliesTo    String       @default("BRANCH") @map("applies_to") // BRANCH | FRANCHISE | BOTH
  sortOrder    Int          @default(0) @map("sort_order")

  accounts Account[]

  @@map("account_templates")
}

model Account {
  id                 String              @id @default(uuid())
  code               String              @unique
  title              String
  class              AccountClass
  normalBalance      NormalBalance       @map("normal_balance")
  branchTagId        String?             @map("branch_tag_id")
  channelTag         String?             @map("channel_tag")
  entryScope         EntryScope          @default(MAIN) @map("entry_scope")
  isPaymentAccount   Boolean             @default(false) @map("is_payment_account")
  paymentAccountType PaymentAccountType? @map("payment_account_type")
  counterpartyType   String?             @map("counterparty_type") // DEALER | FRANCHISE | AGENT | SUPPLIER | CONSIGNEE | EMPLOYEE
  counterpartyId     String?             @map("counterparty_id")
  templateId         String?             @map("template_id")
  parentCode         String?             @map("parent_code")
  sortOrder          Int                 @default(0) @map("sort_order")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  createdBy          String?             @map("created_by")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  updatedBy          String?             @map("updated_by")

  branchTag         Location?          @relation(fields: [branchTagId], references: [id])
  template          AccountTemplate?   @relation(fields: [templateId], references: [id])
  journalLines      JournalLine[]
  expenseDocs       ExpenseDoc[]       @relation("ExpenseAccount")
  expensePaidFrom   ExpenseDoc[]       @relation("ExpensePaidFrom")
  salesDocs         SalesDoc[]
  payments          Payment[]
  cashDeposits      CashDeposit[]
  suppliers         Supplier[]
  customers         Customer[]
  agents            Agent[]
  fixedAssets       FixedAsset[]       @relation("AssetAccount")
  accumDepnFor      FixedAsset[]       @relation("AccumDepnAccount")
  beginningBalances BeginningBalance[]

  @@index([class])
  @@index([branchTagId])
  @@map("accounts")
}

enum Book {
  BENTA
  GENERAL
  ADVANCES
  GASTOS_OPEX
  GASTOS_DC
}

model JournalVoucher {
  id                 String    @id @default(uuid())
  voucherNo          String    @unique @map("voucher_no") // A-2026-000001 / M-2026-000001 / OB-2026
  date               DateTime  @db.Date
  book               Book
  reference          String?
  remarks            String?
  name               String? // payee / payor
  sourceDocumentType String?   @map("source_document_type")
  sourceDocumentId   String?   @map("source_document_id")
  rule               String? // R1..R14 for auto entries
  isReversal         Boolean   @default(false) @map("is_reversal")
  reversesVoucherId  String?   @map("reverses_voucher_id")
  postedAt           DateTime  @default(now()) @map("posted_at")
  createdBy          String?   @map("created_by")
  voidedAt           DateTime? @map("voided_at")
  voidedBy           String?   @map("voided_by")
  voidReason         String?   @map("void_reason")

  lines JournalLine[]

  @@index([date])
  @@index([sourceDocumentType, sourceDocumentId])
  @@map("journal_vouchers")
}

model JournalLine {
  id        String  @id @default(uuid())
  voucherId String  @map("voucher_id")
  lineNo    Int     @map("line_no")
  accountId String  @map("account_id")
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)
  memo      String?

  voucher JournalVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("journal_lines")
}

model BeginningBalance {
  id                String   @id @default(uuid())
  fiscalYear        Int      @map("fiscal_year")
  accountId         String   @map("account_id")
  debit             Decimal  @default(0) @db.Decimal(14, 2)
  credit            Decimal  @default(0) @db.Decimal(14, 2)
  approvalRequestId String?  @map("approval_request_id")
  postedVoucherId   String?  @map("posted_voucher_id")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String?  @map("created_by")

  account Account @relation(fields: [accountId], references: [id])

  @@unique([fiscalYear, accountId])
  @@map("beginning_balances")
}

model AccountingPeriod {
  id                String    @id @default(uuid())
  year              Int
  month             Int
  locked            Boolean   @default(false)
  lockedAt          DateTime? @map("locked_at")
  lockedBy          String?   @map("locked_by")
  approvalRequestId String?   @map("approval_request_id")

  @@unique([year, month])
  @@map("accounting_periods")
}

model VoucherSequence {
  id     String @id @default(uuid())
  prefix String // A | M
  year   Int
  nextNo Int    @default(1) @map("next_no")

  @@unique([prefix, year])
  @@map("voucher_sequences")
}

model FixedAsset {
  id                 String   @id @default(uuid())
  name               String
  assetAccountId     String   @map("asset_account_id")
  accumDepnAccountId String   @map("accum_depn_account_id")
  cost               Decimal  @db.Decimal(14, 2)
  salvageValue       Decimal  @default(0) @map("salvage_value") @db.Decimal(14, 2)
  usefulLifeMonths   Int      @map("useful_life_months")
  startDate          DateTime @map("start_date") @db.Date
  locationId         String?  @map("location_id")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  assetAccount     Account             @relation("AssetAccount", fields: [assetAccountId], references: [id])
  accumDepnAccount Account             @relation("AccumDepnAccount", fields: [accumDepnAccountId], references: [id])
  depreciations    DepreciationEntry[]

  @@map("fixed_assets")
}

model DepreciationEntry {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  year      Int
  month     Int
  amount    Decimal  @db.Decimal(14, 2)
  voucherId String?  @map("voucher_id")
  createdAt DateTime @default(now()) @map("created_at")

  asset FixedAsset @relation(fields: [assetId], references: [id])

  @@unique([assetId, year, month])
  @@map("depreciation_entries")
}

// ───────────────────────────── Payroll / HR (Phase 2) ─────────────────────────────

model Employee {
  id           String   @id @default(uuid())
  employeeNo   String   @unique @map("employee_no")
  fullName     String   @map("full_name")
  locationId   String?  @map("location_id") // cost centre
  position     String?
  basicRate    Decimal  @default(0) @map("basic_rate") @db.Decimal(14, 2)
  payFrequency String   @default("SEMI_MONTHLY") @map("pay_frequency")
  sssNo        String?  @map("sss_no")
  phicNo       String?  @map("phic_no")
  hdmfNo       String?  @map("hdmf_no")
  bankAccount  String?  @map("bank_account")
  userId       String?  @unique @map("user_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  location          Location?              @relation(fields: [locationId], references: [id])
  user              User?                  @relation(fields: [userId], references: [id])
  payrollLines      PayrollLine[]
  loans             EmployeeLoan[]
  chargeAllocations ChargeFormAllocation[]

  @@map("employees")
}

model EmployeeLoan {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  kind       String // SSS_LOAN | HDMF_LOAN | VALE | ADVANCE
  principal  Decimal  @db.Decimal(14, 2)
  balance    Decimal  @db.Decimal(14, 2)
  perPeriod  Decimal  @map("per_period") @db.Decimal(14, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_loans")
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  CLOSED
}

model PayrollRun {
  id                String        @id @default(uuid())
  periodFrom        DateTime      @map("period_from") @db.Date
  periodTo          DateTime      @map("period_to") @db.Date
  status            PayrollStatus @default(DRAFT)
  finalizedAt       DateTime?     @map("finalized_at")
  finalizedBy       String?       @map("finalized_by")
  closedAt          DateTime?     @map("closed_at")
  closedBy          String?       @map("closed_by")
  paidFromAccountId String?       @map("paid_from_account_id")
  finalizeVoucherId String?       @map("finalize_voucher_id")
  closeVoucherId    String?       @map("close_voucher_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  createdBy         String?       @map("created_by")

  lines PayrollLine[]

  @@map("payroll_runs")
}

model PayrollLine {
  id                     String  @id @default(uuid())
  runId                  String  @map("run_id")
  employeeId             String  @map("employee_id")
  basic                  Decimal @default(0) @db.Decimal(14, 2)
  overtime               Decimal @default(0) @db.Decimal(14, 2)
  incentives             Decimal @default(0) @db.Decimal(14, 2)
  thirteenthMonthAccrual Decimal @default(0) @map("thirteenth_month_accrual") @db.Decimal(14, 2)
  sssEe                  Decimal @default(0) @map("sss_ee") @db.Decimal(14, 2)
  sssEr                  Decimal @default(0) @map("sss_er") @db.Decimal(14, 2)
  phicEe                 Decimal @default(0) @map("phic_ee") @db.Decimal(14, 2)
  phicEr                 Decimal @default(0) @map("phic_er") @db.Decimal(14, 2)
  hdmfEe                 Decimal @default(0) @map("hdmf_ee") @db.Decimal(14, 2)
  hdmfEr                 Decimal @default(0) @map("hdmf_er") @db.Decimal(14, 2)
  loans                  Decimal @default(0) @db.Decimal(14, 2)
  chargeDeductions       Decimal @default(0) @map("charge_deductions") @db.Decimal(14, 2)
  otherDeductions        Decimal @default(0) @map("other_deductions") @db.Decimal(14, 2)
  netPay                 Decimal @default(0) @map("net_pay") @db.Decimal(14, 2)

  run      PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@map("payroll_lines")
}

model ContributionTable {
  id            String   @id @default(uuid())
  kind          String // SSS | PHIC | HDMF
  effectiveFrom DateTime @map("effective_from") @db.Date
  rows          Json // [{from, to, ee, er}] or {rateEe, rateEr, min, max}
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("contribution_tables")
}

/// Branch cash fund (imprest / revolving fund): small expenses are paid from it and it is topped back up from the day's cash sales.
model CashFund {
  id            String   @id @default(uuid())
  locationId    String   @unique @map("location_id")
  imprestAmount Decimal  @map("imprest_amount") @db.Decimal(14, 2)
  balance       Decimal  @db.Decimal(14, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")
  updatedAt     DateTime @updatedAt @map("updated_at")

  location Location      @relation(fields: [locationId], references: [id])
  txns     CashFundTxn[]

  @@map("cash_funds")
}

model CashFundTxn {
  controlNo    String?  @unique @map("control_no") // replenishment voucher number, e.g. WA-FR-000004
  id           String   @id @default(uuid())
  fundId       String   @map("fund_id")
  locationId   String   @map("location_id")
  businessDate DateTime @map("business_date") @db.Date
  kind         String // SETUP | TOP_UP | EXPENSE | EXPENSE_VOID | REPLENISH | ADJUST
  amount       Decimal  @db.Decimal(14, 2) // signed: + into the fund, − out of it
  balanceAfter Decimal  @map("balance_after") @db.Decimal(14, 2)
  expenseDocId String?  @map("expense_doc_id")
  notes        String?
  createdBy    String?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  fund CashFund @relation(fields: [fundId], references: [id])

  @@index([locationId, businessDate])
  @@map("cash_fund_txns")
}

/// Field Auditor's count of the cash fund actually found in the store vs the system balance.
model CashFundCheck {
  id            String   @id @default(uuid())
  locationId    String   @map("location_id")
  checkedAt     DateTime @default(now()) @map("checked_at")
  countedAmount Decimal  @map("counted_amount") @db.Decimal(14, 2)
  systemBalance Decimal  @map("system_balance") @db.Decimal(14, 2)
  variance      Decimal  @db.Decimal(14, 2)
  reason        String?
  inspectionId  String?  @map("inspection_id")
  checkedBy     String   @map("checked_by")

  @@index([locationId, checkedAt])
  @@map("cash_fund_checks")
}

/// Store Inspection Report (the Field Auditor's branch checklist: store, permits, stocks, staff) — submitted to HR, Admin and Head Auditor notified.
model StoreInspection {
  id                    String    @id @default(uuid())
  controlNo             String    @unique @map("control_no")
  locationId            String    @map("location_id")
  inspectionDate        DateTime  @map("inspection_date") @db.Date
  inspectorId           String    @map("inspector_id")
  staffOnDutyEmployeeId String?   @map("staff_on_duty_employee_id")
  staffOnDutyName       String?   @map("staff_on_duty_name")
  items                 Json // [{key, status: COMPLIED|NO|NA, date?, amount?, reason?}]
  comments              String?
  cashFundCounted       Decimal?  @map("cash_fund_counted") @db.Decimal(14, 2)
  cashFundSystem        Decimal?  @map("cash_fund_system") @db.Decimal(14, 2)
  status                String    @default("DRAFT") // DRAFT | SUBMITTED | REVIEWED
  submittedAt           DateTime? @map("submitted_at")
  staffAcknowledgedAt   DateTime? @map("staff_acknowledged_at")
  staffAcknowledgedBy   String?   @map("staff_acknowledged_by")
  hrReviewedAt          DateTime? @map("hr_reviewed_at")
  hrReviewedBy          String?   @map("hr_reviewed_by")
  hrNotes               String?   @map("hr_notes")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id])

  @@index([locationId, inspectionDate])
  @@map("store_inspections")
}

/// Every approved correction of someone's document (owner request 2026-09-26): who made the original, who asked, who approved, what
/// changed. Used to see which staff have many errors in their reports.
model DocumentRevision {
  id           String   @id @default(uuid())
  source       String // AUDIT_REVISION | POST_CLOSE_EDIT | WAREHOUSE_EDIT | COUNT_REVISION
  documentType String   @map("document_type")
  documentId   String   @map("document_id")
  controlNo    String?  @map("control_no")
  locationId   String?  @map("location_id")
  staffUserId  String?  @map("staff_user_id") // the person whose document was corrected
  requestedBy  String?  @map("requested_by")
  approvedBy   String?  @map("approved_by")
  reason       String?
  changes      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([staffUserId, createdAt])
  @@index([documentType, documentId])
  @@map("document_revisions")
}

/// Monthly remittance of government contributions (EE share deducted + ER share) to SSS / PhilHealth / Pag-IBIG.
model ContributionRemittance {
  id                String   @id @default(uuid())
  kind              String // SSS | PHIC | HDMF
  year              Int
  month             Int
  amountEe          Decimal  @map("amount_ee") @db.Decimal(14, 2)
  amountEr          Decimal  @map("amount_er") @db.Decimal(14, 2)
  total             Decimal  @db.Decimal(14, 2)
  referenceNo       String   @map("reference_no")
  paidAt            DateTime @map("paid_at") @db.Date
  paidFromAccountId String?  @map("paid_from_account_id")
  voucherId         String?  @map("voucher_id")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([kind, year, month])
  @@map("contribution_remittances")
}

// Session store lives in Redis; this table records login devices for audit.
model LoginSessionRecord {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  sessionId String    @unique @map("session_id")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("login_session_records")
}

/// Every selling price or supplier cost change, for the dashboard "Price updates" list (tier null = supplier cost).
model PriceUpdateLog {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  productName   String   @map("product_name")
  tier          String?
  oldValue      Decimal? @map("old_value") @db.Decimal(14, 2)
  newValue      Decimal? @map("new_value") @db.Decimal(14, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  source        String
  sourceRef     String?  @map("source_ref")
  link          String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("price_update_logs")
}

/// Salary a franchise owner pays their own associate (not company payroll; HR has no access). Posted as a franchise expense.
model FranchiseSalary {
  id              String    @id @default(uuid())
  locationId      String    @map("location_id")
  userId          String    @map("user_id")
  periodFrom      DateTime  @map("period_from") @db.Date
  periodTo        DateTime  @map("period_to") @db.Date
  basic           Decimal   @db.Decimal(14, 2)
  allowances      Decimal   @default(0) @db.Decimal(14, 2)
  otherDeductions Decimal   @default(0) @map("other_deductions") @db.Decimal(14, 2)
  chargesDeducted Decimal   @default(0) @map("charges_deducted") @db.Decimal(14, 2)
  netPay          Decimal   @map("net_pay") @db.Decimal(14, 2)
  notes           String?
  expenseId       String?   @map("expense_id")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  voidedAt        DateTime? @map("voided_at")

  @@index([locationId, userId])
  @@map("franchise_salaries")
}

/// Charge a franchise owner makes to their own associate (shortage, damage, discrepancy); deducted from the franchise salary.
model FranchiseCharge {
  id                 String    @id @default(uuid())
  locationId         String    @map("location_id")
  userId             String    @map("user_id")
  kind               String    @default("OTHER")
  reason             String
  amount             Decimal   @db.Decimal(14, 2)
  sourceChargeFormId String?   @map("source_charge_form_id")
  salaryId           String?   @map("salary_id")
  acknowledgedAt     DateTime? @map("acknowledged_at")
  createdBy          String?   @map("created_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  voidedAt           DateTime? @map("voided_at")

  @@index([locationId, userId])
  @@map("franchise_charges")
}

/// A branch asks for more days to deposit one day's cash; the Head Auditor and Admin both approve (owner request 2026-09-27).
model CashDepositExtension {
  id                String    @id @default(uuid())
  locationId        String    @map("location_id")
  businessDate      DateTime  @map("business_date") @db.Date
  requestedUntil    DateTime  @map("requested_until") @db.Date
  reason            String
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvalRequestId String?   @map("approval_request_id")
  requestedBy       String    @map("requested_by")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([locationId, businessDate])
  @@map("cash_deposit_extensions")
}

/// Something HR must act on, e.g. a Notice to Explain for cash not deposited on time (owner request 2026-09-27).
model HrNotice {
  id         String    @id @default(uuid())
  kind       String // CASH_DEPOSIT_OVERDUE
  dedupeKey  String    @unique @map("dedupe_key")
  locationId String?   @map("location_id")
  title      String
  details    Json?
  staffIds   Json?     @map("staff_ids") // users on duty at the branch
  status     String    @default("OPEN") // OPEN | NTE_ISSUED | CLOSED
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by")

  @@index([status])
  @@map("hr_notices")
}

/// The day's Daily Branch Sales Report as submitted by the branch ("true and correct"), or submitted automatically at the cut-off
/// with whatever was entered by then (owner request 2026-09-27). Later changes go through post-close revision requests.
model SalesReportSubmission {
  id              String   @id @default(uuid())
  locationId      String   @map("location_id")
  businessDate    DateTime @map("business_date") @db.Date
  status          String // SUBMITTED | AUTO_SUBMITTED
  submittedBy     String?  @map("submitted_by")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  acknowledgement String?
  overallSales    Decimal  @default(0) @map("overall_sales") @db.Decimal(14, 2)
  cashDeposit     Decimal  @default(0) @map("cash_deposit") @db.Decimal(14, 2)
  snapshot        Json

  @@unique([locationId, businessDate])
  @@map("sales_report_submissions")
}

/// A customer who bought an item with a known consumption period: when it is probably used up, the store is reminded to call,
/// and an SMS / email can be sent (owner request 2026-09-27).
model CustomerFollowUp {
  id           String    @id @default(uuid())
  salesDocId   String    @map("sales_doc_id")
  salesLineId  String    @unique @map("sales_line_id")
  productId    String    @map("product_id")
  locationId   String    @map("location_id")
  customerName String?   @map("customer_name")
  phone        String?
  email        String?
  qty          Int
  dueDate      DateTime  @map("due_date") @db.Date
  status       String    @default("PENDING") // PENDING | NOTIFIED | CONTACTED | DISMISSED
  notifiedAt   DateTime? @map("notified_at")
  smsSentAt    DateTime? @map("sms_sent_at")
  emailSentAt  DateTime? @map("email_sent_at")
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, dueDate])
  @@index([locationId, status])
  @@map("customer_follow_ups")
}

/// Every SMS / email sent to a customer, with its result.
model CustomerMessage {
  id         String   @id @default(uuid())
  channel    String // SMS | EMAIL
  to         String
  subject    String?
  body       String
  status     String // SENT | FAILED | NOT_CONFIGURED
  error      String?
  followUpId String?  @map("follow_up_id")
  sentBy     String?  @map("sent_by") // null = automatic
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([followUpId])
  @@map("customer_messages")
}

// ───────────────────────────── E-commerce (TikTok, Shopee, Lazada — kept separate) ─────────────────────────────

/// Platform SKU → GWS product, remembered after the E-comm Associate matches it once.
model EcomSkuMap {
  id          String   @id @default(uuid())
  platform    String // TIKTOK | SHOPEE | LAZADA
  platformSku String   @map("platform_sku")
  productId   String   @map("product_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([platform, platformSku])
  @@map("ecom_sku_maps")
}

/// One platform order from the uploaded order / waybill file. Drives the pull-out, then the sale when the platform pays.
model EcomOrder {
  id           String    @id @default(uuid())
  platform     String
  orderId      String    @map("order_id")
  trackingNo   String?   @map("tracking_no")
  /// PENDING (on a draft pull-out) → SHIPPED (pull-out approved) → SETTLED (paid) | RETURNED | CANCELLED | REJECTED
  status       String    @default("PENDING")
  pullOutId    String?   @map("pull_out_id")
  settlementId String?   @map("settlement_id")
  salesDocId   String?   @map("sales_doc_id")
  sourceFile   String?   @map("source_file")
  shippedAt    DateTime? @map("shipped_at")
  settledAt    DateTime? @map("settled_at")
  returnedAt   DateTime? @map("returned_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lines EcomOrderLine[]

  @@unique([platform, orderId])
  @@index([platform, status])
  @@index([pullOutId])
  @@map("ecom_orders")
}

model EcomOrderLine {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  platformSku String  @map("platform_sku")
  productName String? @map("product_name")
  qty         Int

  order EcomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("ecom_order_lines")
}

/// One uploaded settlement (payout) file: the sale, each platform fee, refunds, withholding tax and the payout. Accounting approves before it posts.
model EcomSettlement {
  id                String    @id @default(uuid())
  controlNo         String    @unique @map("control_no")
  platform          String
  docDate           DateTime  @map("doc_date") @db.Date
  /// DRAFT → SUBMITTED → POSTED | REJECTED
  status            String    @default("DRAFT")
  sourceFile        String?   @map("source_file")
  orders            Int       @default(0)
  grossSales        Decimal   @default(0) @map("gross_sales") @db.Decimal(14, 2)
  sellerDiscounts   Decimal   @default(0) @map("seller_discounts") @db.Decimal(14, 2)
  commission        Decimal   @default(0) @db.Decimal(14, 2)
  transactionFee    Decimal   @default(0) @map("transaction_fee") @db.Decimal(14, 2)
  shippingFee       Decimal   @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  affiliateFee      Decimal   @default(0) @map("affiliate_fee") @db.Decimal(14, 2)
  otherFees         Decimal   @default(0) @map("other_fees") @db.Decimal(14, 2)
  refunds           Decimal   @default(0) @db.Decimal(14, 2)
  withholdingTax    Decimal   @default(0) @map("withholding_tax") @db.Decimal(14, 2)
  adjustments       Decimal   @default(0) @db.Decimal(14, 2)
  payout            Decimal   @default(0) @db.Decimal(14, 2)
  /// payout total of the whole file (including orders not in GWS-ERP) for the reconciliation
  filePayout        Decimal   @default(0) @map("file_payout") @db.Decimal(14, 2)
  costOfSales       Decimal   @default(0) @map("cost_of_sales") @db.Decimal(14, 2)
  includeUnmatched  Boolean   @default(false) @map("include_unmatched")
  details           Json // per order: amounts, match status
  approvalRequestId String?   @map("approval_request_id")
  postedAt          DateTime? @map("posted_at")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([platform, docDate])
  @@map("ecom_settlements")
}

/// A parcel that came back (failed delivery / return to seller, or a buyer return). The In-Charge receives it and marks each item good or damaged.
model EcomReturn {
  id          String    @id @default(uuid())
  controlNo   String    @unique @map("control_no")
  platform    String
  ecomOrderId String    @map("ecom_order_id")
  reason      String? // FAILED_DELIVERY | BUYER_RETURN | OTHER
  notes       String?
  /// PENDING (waiting for the warehouse) → RECEIVED
  status      String    @default("PENDING")
  lines       Json // [{ productId, qty, goodQty?, damagedQty? }]
  writeoffId  String?   @map("writeoff_id")
  receivedBy  String?   @map("received_by")
  receivedAt  DateTime? @map("received_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([platform, status])
  @@map("ecom_returns")
}

/// Advertising spend per platform and month (TikTok Ads / Shopee Ads / Lazada Sponsored Solutions): an expense.
model EcomAdSpend {
  id                String   @id @default(uuid())
  platform          String
  month             String // YYYY-MM
  amount            Decimal  @db.Decimal(14, 2)
  /// null = deducted from the platform balance (e.g. TikTok GMV Pay); otherwise the bank / card account that paid
  paidFromAccountId String?  @map("paid_from_account_id")
  reference         String?
  notes             String?
  sourceFile        String?  @map("source_file")
  createdBy         String?  @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([platform, month])
  @@map("ecom_ad_spend")
}

/// A difference between a transfer form and what the receiving branch actually got (owner request 2026-09-29).
/// Steps: HEAD_AUDITOR review → SENDER confirms (2 days) → ADMIN when the sender disagrees or does not answer → RESOLVED.
/// A confirmed difference creates adjustment forms numbered after the original (WA-PO-000012-002, -003…).
model TransferDiscrepancy {
  id               String    @id @default(uuid())
  transferId       String    @unique @map("transfer_id")
  controlNo        String    @map("control_no")
  status           String    @default("HEAD_AUDITOR") // HEAD_AUDITOR | SENDER | ADMIN | RESOLVED
  /// [{ productId, name, onForm, received, short, extra, note }]
  lines            Json
  receivedBy       String?   @map("received_by")
  senderUserIds    String[]  @default([]) @map("sender_user_ids")
  senderDueAt      DateTime? @map("sender_due_at")
  senderRemindedAt DateTime? @map("sender_reminded_at")
  /// [{ step, by, byName, decision, note, at }]
  history          Json      @default("[]")
  outcome          String? // RETURN_TO_SENDER | RECEIVED_AS_SENT | LOST_COMPANY | LOST_CHARGE
  adjustmentDocIds String[]  @default([]) @map("adjustment_doc_ids")
  chargeFormId     String?   @map("charge_form_id")
  hrNoticeId       String?   @map("hr_notice_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  resolvedAt       DateTime? @map("resolved_at")

  @@index([status])
  @@map("transfer_discrepancies")
}

/// Monthly sales target per branch or per agent, set by the Sales Manager and approved by the Owner (owner request 2026-09-29).
model SalesTarget {
  id                String    @id @default(uuid())
  month             String // YYYY-MM
  kind              String // BRANCH | AGENT
  locationId        String?   @map("location_id")
  /// an agent is one person even when listed at several branches: the linked user, or the agent's name
  agentKey          String?   @map("agent_key")
  agentName         String?   @map("agent_name")
  amount            Decimal   @db.Decimal(14, 2)
  notes             String?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  approvalRequestId String?   @map("approval_request_id")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  decidedAt         DateTime? @map("decided_at")

  @@index([month, kind, status])
  @@map("sales_targets")
}

/// AR from before GWS-ERP (owner request 2026-09-29): entered by Accounting for any branch, approved by the Owner; on approval it becomes
/// an AR/PDC sales document (no stock lines) in that branch's AR & Collections. No journal entry: the AR beginning balance is in Periods & Opening.
model OpeningArEntry {
  id                String    @id @default(uuid())
  locationId        String    @map("location_id")
  kind              String // DEALER | FRANCHISE | AGENT | OTHER
  customerId        String?   @map("customer_id")
  agentId           String?   @map("agent_id")
  customerName      String?   @map("customer_name")
  drSiNo            String    @map("dr_si_no")
  docDate           DateTime  @map("doc_date") @db.Date
  dueDate           DateTime  @map("due_date") @db.Date
  amount            Decimal   @db.Decimal(14, 2)
  pdcBank           String?   @map("pdc_bank")
  pdcChequeNo       String?   @map("pdc_cheque_no")
  pdcDate           DateTime? @map("pdc_date") @db.Date
  notes             String?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  salesDocId        String?   @map("sales_doc_id")
  approvalRequestId String?   @map("approval_request_id")
  decisionNote      String?   @map("decision_note")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  decidedAt         DateTime? @map("decided_at")

  @@index([status, locationId])
  @@map("opening_ar_entries")
}

/// Agent incentive for one month (owner request 2026-09-30): the Sales Manager confirms the agent's total sales and the incentive; the
/// Accounting Associate, the Accounting Head and the Owner approve; the approved form goes to HR for release; Accounting tags the payment.
model AgentIncentive {
  id                String    @id @default(uuid())
  month             String // YYYY-MM
  agentKey          String    @map("agent_key")
  agentName         String    @map("agent_name")
  agentUserId       String?   @map("agent_user_id")
  branches          String[]  @default([])
  transactions      Int       @default(0)
  totalSales        Decimal   @map("total_sales") @db.Decimal(14, 2)
  collected         Decimal   @db.Decimal(14, 2)
  ratePct           Decimal?  @map("rate_pct") @db.Decimal(6, 3)
  amount            Decimal   @db.Decimal(14, 2)
  notes             String?
  status            String    @default("PENDING") // PENDING | APPROVED (with HR) | SIGNED (agent signed, ready to pay) | RELEASED | REJECTED
  formNo            String?   @unique @map("form_no")
  approvalRequestId String?   @map("approval_request_id")
  preparedBy        String    @map("prepared_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  approvedAt        DateTime? @map("approved_at")
  decisionNote      String?   @map("decision_note")
  hrSignedBy        String?   @map("hr_signed_by")
  hrSignedAt        DateTime? @map("hr_signed_at")
  releaseMode       String?   @map("release_mode") // BANK_TRANSFER | GCASH | CHEQUE | CASH
  releaseAccountId  String?   @map("release_account_id")
  releaseReference  String?   @map("release_reference")
  releaseDate       DateTime? @map("release_date") @db.Date
  releasedBy        String?   @map("released_by")
  releasedAt        DateTime? @map("released_at")

  @@index([month, agentKey])
  @@map("agent_incentives")
}

// ── Franchise receivables (owner request 2026-09-30, memo 2026-07-31): goods billed to a franchise at the franchise price, due by terms;
// 2% one-time penalty + 0.1% per day on the unpaid balance once overdue ──
model FranchiseInvoice {
  id                  String    @id @default(uuid())
  controlNo           String    @unique @map("control_no")
  source              String // TRANSFER | OPENING | SHIPPING
  transferId          String?   @unique @map("transfer_id")
  franchiseLocationId String    @map("franchise_location_id")
  fromLocationId      String?   @map("from_location_id")
  issueDate           DateTime  @map("issue_date") @db.Date
  originalDueDate     DateTime  @map("original_due_date") @db.Date
  dueDate             DateTime  @map("due_date") @db.Date
  originalAmount      Decimal   @map("original_amount") @db.Decimal(14, 2)
  /// the goods now billed (changes when the received quantities change)
  amount              Decimal   @db.Decimal(14, 2)
  principalPaid       Decimal   @default(0) @map("principal_paid") @db.Decimal(14, 2)
  penalty             Decimal   @default(0) @db.Decimal(14, 2)
  penaltyPaid         Decimal   @default(0) @map("penalty_paid") @db.Decimal(14, 2)
  interest            Decimal   @default(0) @db.Decimal(14, 2)
  interestPaid        Decimal   @default(0) @map("interest_paid") @db.Decimal(14, 2)
  waivedTotal         Decimal   @default(0) @map("waived_total") @db.Decimal(14, 2)
  penaltyAppliedOn    DateTime? @map("penalty_applied_on") @db.Date
  interestThrough     DateTime? @map("interest_through") @db.Date
  status              String    @default("OPEN") // OPEN | PAID | CANCELLED
  flaggedAt           DateTime? @map("flagged_at") // unpaid two months after the due date
  remindedAt          DateTime? @map("reminded_at")
  notes               String?
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  payments    FranchisePayment[]
  adjustments FranchiseArAdjustment[]
  extensions  FranchiseArExtension[]

  @@index([franchiseLocationId, status])
  @@index([dueDate])
  @@map("franchise_invoices")
}

model FranchisePayment {
  id                String    @id @default(uuid())
  receiptNo         String    @unique @map("receipt_no")
  invoiceId         String    @map("invoice_id")
  amount            Decimal   @db.Decimal(14, 2)
  toPenalty         Decimal   @default(0) @map("to_penalty") @db.Decimal(14, 2)
  toInterest        Decimal   @default(0) @map("to_interest") @db.Decimal(14, 2)
  toPrincipal       Decimal   @default(0) @map("to_principal") @db.Decimal(14, 2)
  paidOn            DateTime  @map("paid_on") @db.Date
  mode              String
  paymentAccountId  String?   @map("payment_account_id")
  reference         String?
  proofAttachmentId String?   @map("proof_attachment_id")
  notes             String?
  recordedBy        String    @map("recorded_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  voidedAt          DateTime? @map("voided_at")

  invoice FranchiseInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("franchise_payments")
}

model FranchiseArAdjustment {
  id         String   @id @default(uuid())
  invoiceId  String   @map("invoice_id")
  kind       String // TRANSFER_CHANGE | WAIVER | MANUAL | EXTENSION | SHIPPING_EDIT
  delta      Decimal  @db.Decimal(14, 2)
  reason     String
  transferId String?  @map("transfer_id")
  details    Json?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  invoice FranchiseInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("franchise_ar_adjustments")
}

model FranchiseArExtension {
  id                String    @id @default(uuid())
  invoiceId         String    @map("invoice_id")
  requestedBy       String    @map("requested_by")
  reason            String
  previousDueDate   DateTime  @map("previous_due_date") @db.Date
  requestedDueDate  DateTime  @map("requested_due_date") @db.Date
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED
  approvalRequestId String?   @map("approval_request_id")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")
  createdAt         DateTime  @default(now()) @map("created_at")

  invoice FranchiseInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("franchise_ar_extensions")
}

/// Shipping charged to a franchise on a sale (owner request 2026-10-01): tagged "to follow" on the sale, the Franchise Coordinator fills the amount within 2 days,
/// and it becomes its own franchise invoice (separate from the order).
model FranchiseShippingCharge {
  id                  String    @id @default(uuid())
  salesDocId          String    @unique @map("sales_doc_id")
  drSiNo              String    @map("dr_si_no")
  franchiseLocationId String    @map("franchise_location_id")
  fromLocationId      String    @map("from_location_id")
  status              String    @default("TO_FOLLOW") // TO_FOLLOW | FILLED
  fillBy              DateTime  @map("fill_by") @db.Date
  amount              Decimal?  @db.Decimal(14, 2)
  courier             String?
  reference           String?
  notes               String?
  invoiceId           String?   @unique @map("invoice_id")
  filledBy            String?   @map("filled_by")
  filledAt            DateTime? @map("filled_at")
  remindedAt          DateTime? @map("reminded_at")
  /// a change after it was filled, waiting for the Owner: { amount, reason, requestedBy }
  pendingEdit         Json?     @map("pending_edit")
  createdBy           String?   @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, fillBy])
  @@index([franchiseLocationId])
  @@map("franchise_shipping_charges")
}

/// Replacement ticket (owner request 2026-10-02). CUSTOMER: an item the customer returned to us and must be replaced (tied to the DR / SI it was sold on); any branch except a franchise ticks it
/// when it hands the replacement (same or another product; the price difference is worked out) and the Head Auditor approves. SUPPLIER: items we return to a supplier; the ticket stays open until replacement items arrive.
model ReplacementTicket {
  id                   String    @id @default(uuid())
  ticketNo             String    @unique @map("ticket_no")
  kind                 String // CUSTOMER | SUPPLIER
  /// CUSTOMER: OPEN → REPLACED (waiting for the Head Auditor) → CLOSED. SUPPLIER: PENDING_RETURN (Head Auditor approves) → AWAITING_REPLACEMENT → PARTIAL → CLOSED. CANCELLED.
  status               String    @default("OPEN")
  /// the branch / warehouse that took the return from the customer, or sent the items to the supplier
  locationId           String    @map("location_id")
  productId            String    @map("product_id")
  batchId              String?   @map("batch_id")
  qty                  Int
  /// price paid on the DR (customer) or cost (supplier), per unit
  unitValue            Decimal   @default(0) @map("unit_value") @db.Decimal(14, 2)
  reason               String
  notes                String?
  // customer side: the DR / SI the item was sold on
  salesDocId           String?   @map("sales_doc_id")
  salesLineId          String?   @map("sales_line_id")
  drSiNo               String?   @map("dr_si_no")
  saleLocationId       String?   @map("sale_location_id")
  saleControlNo        String?   @map("sale_control_no")
  saleTier             String?   @map("sale_tier")
  customerName         String?   @map("customer_name")
  customerPhone        String?   @map("customer_phone")
  // the replacement handed to the customer
  replacedAt           DateTime? @map("replaced_at")
  replacedBy           String?   @map("replaced_by")
  replacedLocationId   String?   @map("replaced_location_id")
  replacementProductId String?   @map("replacement_product_id")
  replacementQty       Int?      @map("replacement_qty")
  replacementUnitPrice Decimal?  @map("replacement_unit_price") @db.Decimal(14, 2)
  replacementPicks     Json?     @map("replacement_picks")
  /// replacement value − the value on the DR: + the customer pays, − the customer is refunded / credited
  priceDifference      Decimal?  @map("price_difference") @db.Decimal(14, 2)
  replacedOn           DateTime? @map("replaced_on") @db.Date // the day the branch gave the replacement (the stock leaves on this day)
  differenceSettledAt  DateTime? @map("difference_settled_at")
  differenceSettledBy  String?   @map("difference_settled_by")
  differenceNote       String?   @map("difference_note")
  // supplier side
  supplierId           String?   @map("supplier_id")
  sentAt               DateTime? @map("sent_at")
  receivedQty          Int       @default(0) @map("received_qty")
  receivedValue        Decimal   @default(0) @map("received_value") @db.Decimal(14, 2)
  approvalRequestId    String?   @map("approval_request_id")
  closedAt             DateTime? @map("closed_at")
  closedNote           String?   @map("closed_note")
  remindedAt           DateTime? @map("reminded_at")
  createdBy            String    @map("created_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  receipts ReplacementReceipt[]

  @@index([kind, status])
  @@index([supplierId, status])
  @@index([salesDocId])
  @@map("replacement_tickets")
}

model ReplacementReceipt {
  id             String   @id @default(uuid())
  ticketId       String   @map("ticket_id")
  receivingDocId String   @map("receiving_doc_id")
  productId      String   @map("product_id")
  qty            Int
  unitCost       Decimal  @map("unit_cost") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  ticket ReplacementTicket @relation(fields: [ticketId], references: [id])

  @@unique([ticketId, receivingDocId, productId])
  @@map("replacement_receipts")
}

// ── Memorandums (owner request 2026-09-30): numbered YYYY-Qn-NNN, addressed to chosen people, signed by the people the memo names ──
model Memo {
  id          String    @id @default(uuid())
  memoNo      String    @unique @map("memo_no")
  subject     String
  addressedTo String    @map("addressed_to")
  fromText    String    @map("from_text")
  memoDate    DateTime  @map("memo_date") @db.Date
  body        String
  table       Json?
  signers     Json
  audience    Json
  status      String    @default("ISSUED") // ISSUED | VOIDED
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  voidedAt    DateTime? @map("voided_at")
  voidedBy    String?   @map("voided_by")
  voidReason  String?   @map("void_reason")

  recipients MemoRecipient[]

  @@index([memoDate])
  @@map("memos")
}

model MemoRecipient {
  id             String    @id @default(uuid())
  memoId         String    @map("memo_id")
  userId         String    @map("user_id")
  acknowledgedAt DateTime? @map("acknowledged_at")

  memo Memo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@unique([memoId, userId])
  @@index([userId])
  @@map("memo_recipients")
}

// ── 6-Pack Card (owner request 2026-09-30): a sticker per supplement bought (ticked on the DR, customer tagged); six stickers earn a card worth ₱300, booked as a branch expense ──
model SixPackSticker {
  id           String    @id @default(uuid())
  saleId       String    @unique @map("sale_id")
  locationId   String    @map("location_id")
  customerName String    @map("customer_name")
  phone        String
  phoneKey     String    @map("phone_key")
  email        String?
  stickers     Int
  businessDate DateTime  @map("business_date") @db.Date
  issuedBy     String    @map("issued_by")
  issuedAt     DateTime  @default(now()) @map("issued_at")
  voidedAt     DateTime? @map("voided_at")

  @@index([phoneKey])
  @@index([locationId, businessDate])
  @@map("six_pack_stickers")
}

model SixPackRedemption {
  id                String    @id @default(uuid())
  controlNo         String    @unique @map("control_no")
  locationId        String    @map("location_id")
  customerName      String    @map("customer_name")
  phone             String
  phoneKey          String    @map("phone_key")
  email             String?
  address           String?
  stickersUsed      Int       @map("stickers_used")
  amount            Decimal   @db.Decimal(14, 2)
  expenseId         String?   @map("expense_id")
  legacyCardNo      String?   @map("legacy_card_no")
  proofAttachmentId String?   @map("proof_attachment_id")
  businessDate      DateTime  @map("business_date") @db.Date
  redeemedBy        String    @map("redeemed_by")
  redeemedAt        DateTime  @default(now()) @map("redeemed_at")
  flaggedNote       String?   @map("flagged_note")
  voidedAt          DateTime? @map("voided_at")

  @@index([phoneKey])
  @@index([locationId, businessDate])
  @@map("six_pack_redemptions")
}

/// One shipping label (waybill) uploaded by the E-comm Associate, Head Auditor or Owner: the report works out SRP, fees and order income from it.
model EcomWaybill {
  id         String    @id @default(uuid())
  platform   String // TIKTOK | SHOPEE | LAZADA | UNKNOWN
  orderId    String    @map("order_id")
  trackingNo String?   @map("tracking_no")
  qty        Int       @default(1)
  weightG    Int?      @map("weight_g")
  rtsDate    DateTime? @map("rts_date") @db.Date
  productId  String?   @map("product_id")
  /// the product was filled from what was chosen before for the same weight: confirm it
  guessed    Boolean   @default(false)
  sourceFile String?   @map("source_file")
  uploadedBy String?   @map("uploaded_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([platform, orderId])
  @@index([createdAt])
  @@map("ecom_waybills")
}

model EcomWaybillHint {
  id        String   @id @default(uuid())
  platform  String
  weightG   Int      @map("weight_g")
  productId String   @map("product_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([platform, weightG])
  @@map("ecom_waybill_hints")
}

// ── Agent field work (owner request 2026-10-02): areas, outlets / gyms, daily itineraries with visit photos, consignment limit ──
enum OutletStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A territory the Sales Manager assigns to an agent.
model SalesArea {
  id        String   @id @default(uuid())
  name      String   @unique
  notes     String?
  agentKey  String?  @map("agent_key")
  agentName String?  @map("agent_name")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlets Outlet[]

  @@map("sales_areas")
}

/// A gym / store an agent visits. Uploaded by the agent, approved by the Sales Manager before it can be tagged on a sale or itinerary. Pictures are attachments (documentType Outlet).
model Outlet {
  id           String       @id @default(uuid())
  name         String
  outletType   String       @default("GYM") @map("outlet_type")
  address      String?
  city         String?
  areaId       String?      @map("area_id")
  agentKey     String       @map("agent_key")
  agentName    String       @map("agent_name")
  contactName  String?      @map("contact_name")
  phone        String?
  email        String?
  notes        String?
  status       OutletStatus @default(PENDING)
  active       Boolean      @default(true)
  /// pipeline: PROSPECT → VISITED → SAMPLE_GIVEN → FIRST_ORDER → REGULAR (moves on its own with visits and tagged sales)
  stage        String       @default("PROSPECT")
  lat          Float?
  lng          Float?
  deletedAt    DateTime?    @map("deleted_at")
  rejectReason String?      @map("reject_reason")
  approvedBy   String?      @map("approved_by")
  approvedAt   DateTime?    @map("approved_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  createdBy    String?      @map("created_by")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  area      SalesArea?      @relation(fields: [areaId], references: [id])
  stops     ItineraryStop[]
  salesDocs SalesDoc[]
  shares    OutletShare[]
  changes   OutletChange[]

  @@index([agentKey])
  @@index([areaId])
  @@map("outlets")
}

/// One agent's plan (and report) for one day.
model Itinerary {
  id                String    @id @default(uuid())
  agentKey          String    @map("agent_key")
  agentName         String    @map("agent_name")
  planDate          DateTime  @map("plan_date") @db.Date
  notes             String?
  reportSubmittedAt DateTime? @map("report_submitted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")

  stops  ItineraryStop[]
  claims ItineraryClaim[]

  @@unique([agentKey, planDate])
  @@map("itineraries")
}

model ItineraryStop {
  id          String    @id @default(uuid())
  itineraryId String    @map("itinerary_id")
  outletId    String    @map("outlet_id")
  seq         Int       @default(0)
  status      String    @default("PLANNED") // PLANNED | VISITED | MISSED
  note        String?
  visitedAt   DateTime? @map("visited_at")
  lat         Float?
  lng         Float?
  /// shelf check at the outlet: ON_SHELF | LOW_STOCK | OUT_OF_STOCK | NOT_CARRIED
  shelfStatus String?   @map("shelf_status")
  competitors String?

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  outlet    Outlet    @relation(fields: [outletId], references: [id])

  @@unique([itineraryId, outletId])
  @@index([outletId])
  @@map("itinerary_stops")
}

/// Maximum total consignment (valued at retail price) an agent may hold: set by the Sales Manager, approved by the Owner.
model AgentConsignmentLimit {
  id                String    @id @default(uuid())
  agentKey          String    @map("agent_key")
  agentName         String    @map("agent_name")
  /// set: the maximum for this one outlet's consignee; empty: the agent's total across all outlets
  outletId          String?   @map("outlet_id")
  outletName        String?   @map("outlet_name")
  amount            Decimal   @db.Decimal(14, 2)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUPERSEDED
  notes             String?
  approvalRequestId String?   @map("approval_request_id")
  decidedAt         DateTime? @map("decided_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")

  @@index([agentKey, status])
  @@map("agent_consignment_limits")
}

/// An outlet shared with another agent (the Sales Manager decides); the first agent stays its owner.
model OutletShare {
  id        String   @id @default(uuid())
  outletId  String   @map("outlet_id")
  agentKey  String   @map("agent_key")
  agentName String   @map("agent_name")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, agentKey])
  @@index([agentKey])
  @@map("outlet_shares")
}

/// A change an agent asks for on an approved outlet: the Sales Manager approves it and the Owner is told what changed.
model OutletChange {
  id              String    @id @default(uuid())
  outletId        String    @map("outlet_id")
  changes         Json
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy     String    @map("requested_by")
  requestedByName String    @map("requested_by_name")
  decidedBy       String?   @map("decided_by")
  decidedAt       DateTime? @map("decided_at")
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at")

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, status])
  @@map("outlet_changes")
}

/// Fuel / transport / meal claim for the day's itinerary; the Sales Manager approves, Accounting is told to pay. Receipt photo = attachment (ItineraryClaim).
model ItineraryClaim {
  id          String    @id @default(uuid())
  itineraryId String    @map("itinerary_id")
  kind        String // FUEL | TRANSPORT | MEAL | OTHER
  amount      Decimal   @db.Decimal(14, 2)
  note        String?
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedBy   String?   @map("decided_by")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@map("itinerary_claims")
}

// ── Wheysted members (owner request 2026-10-03): customers who are members, a QR card, a portal of their own, and campaigns ──
model Member {
  id                 String    @id @default(uuid())
  /// printed on the card: WHY-000001
  memberNo           String    @unique @map("member_no")
  /// secret behind the QR code (the QR says WHY:<token>)
  qrToken            String    @unique @map("qr_token")
  fullName           String    @map("full_name")
  phone              String?
  /// last 10 digits of the mobile number: one member per number
  phoneKey           String?   @unique @map("phone_key")
  email              String?
  /// lower-case email: one member per email
  emailKey           String?   @unique @map("email_key")
  birthday           DateTime? @db.Date
  passwordHash       String?   @map("password_hash")
  emailOptIn         Boolean   @default(true) @map("email_opt_in")
  smsOptIn           Boolean   @default(true) @map("sms_opt_in")
  /// PORTAL (signed up) | STAFF (added at the counter) | IMPORT (made from the customer database)
  source             String    @default("STAFF")
  status             String    @default("ACTIVE") // ACTIVE | BLOCKED
  notes              String?
  /// fitness profile and how they came to us (owner request 2026-10-03)
  goal               String?
  gym                String?
  trainingDays       String?   @map("training_days")
  budget             String?
  dietary            String?
  flavorLikes        String?   @map("flavor_likes")
  flavorDislikes     String?   @map("flavor_dislikes")
  heardFrom          String?   @map("heard_from")
  /// the agent's outlet / gym this member trains at
  outletId           String?   @map("outlet_id")
  preferredChannel   String?   @map("preferred_channel") // SMS | EMAIL | WHATSAPP | VIBER | MESSENGER
  bestTime           String?   @map("best_time") // MORNING | AFTERNOON | EVENING
  messengerHandle    String?   @map("messenger_handle")
  referredById       String?   @map("referred_by_id")
  referralRewardedAt DateTime? @map("referral_rewarded_at")
  consentAt          DateTime? @map("consent_at")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  createdBy          String?   @map("created_by")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  salesDocs    SalesDoc[]
  recipients   CampaignRecipient[]
  vouchers     MemberVoucher[]
  points       MemberPointsEntry[]
  notes_       MemberNote[]
  reservations Reservation[]

  @@map("members")
}

/// An email or SMS blast. Recipients are fixed when it is prepared; sending goes one by one.
model Campaign {
  id         String    @id @default(uuid())
  channel    String // EMAIL | SMS
  name       String
  subject    String?
  body       String
  audience   Json
  status     String    @default("DRAFT") // DRAFT | SENDING | DONE | FAILED
  total      Int       @default(0)
  sent       Int       @default(0)
  failed     Int       @default(0)
  skipped    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String    @map("created_by")
  sentAt     DateTime? @map("sent_at")
  finishedAt DateTime? @map("finished_at")

  recipients CampaignRecipient[]

  @@map("campaigns")
}

model CampaignRecipient {
  id          String    @id @default(uuid())
  campaignId  String    @map("campaign_id")
  memberId    String?   @map("member_id")
  name        String
  toAddr      String    @map("to_addr")
  voucherCode String?   @map("voucher_code")
  status      String    @default("PENDING") // PENDING | SENT | FAILED | SKIPPED | NOT_CONFIGURED
  error       String?
  sentAt      DateTime? @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   Member?  @relation(fields: [memberId], references: [id])

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

/// People (members or not) who asked not to get emails / SMS; kept by email or by phone key.
model MessageOptOut {
  id        String   @id @default(uuid())
  channel   String // EMAIL | SMS
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([channel, key])
  @@map("message_opt_outs")
}

/// A single-use voucher for one member (birthday, win-back, referral, points, manual); the counter applies it to a sale.
model MemberVoucher {
  id              String    @id @default(uuid())
  code            String    @unique
  memberId        String    @map("member_id")
  kind            String // PERCENT | AMOUNT
  value           Decimal   @db.Decimal(14, 2)
  minPurchase     Decimal   @default(0) @map("min_purchase") @db.Decimal(14, 2)
  source          String // BIRTHDAY | ANNIVERSARY | WINBACK | REFERRAL | POINTS | CAMPAIGN | MANUAL
  note            String?
  expiresOn       DateTime  @map("expires_on") @db.Date
  usedAt          DateTime? @map("used_at")
  usedSaleId      String?   @map("used_sale_id")
  discountApplied Decimal?  @map("discount_applied") @db.Decimal(14, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, usedAt])
  @@map("member_vouchers")
}

/// Points: earned from purchases (computed), these are the redemptions and adjustments.
model MemberPointsEntry {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  points    Int
  reason    String
  refId     String?  @map("ref_id")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("member_points_entries")
}

/// Contact log: calls, complaints, notes.
model MemberNote {
  id            String   @id @default(uuid())
  memberId      String   @map("member_id")
  kind          String // CALL | COMPLAINT | NOTE | MESSAGE
  text          String
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")
  createdByName String?  @map("created_by_name")

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("member_notes")
}

/// A member-only price for a product while it runs.
model MemberOffer {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  price     Decimal   @db.Decimal(14, 2)
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  active    Boolean   @default(true)
  note      String?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")

  @@index([productId, active])
  @@map("member_offers")
}

/// A "how was it?" invitation for one purchase; the link has the token.
model SurveyInvite {
  id         String    @id @default(uuid())
  token      String    @unique
  memberId   String    @map("member_id")
  saleId     String    @unique @map("sale_id")
  sentAt     DateTime? @map("sent_at")
  answeredAt DateTime? @map("answered_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  response SurveyResponse?

  @@map("survey_invites")
}

model SurveyResponse {
  id        String   @id @default(uuid())
  inviteId  String   @unique @map("invite_id")
  memberId  String   @map("member_id")
  saleId    String   @map("sale_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  invite SurveyInvite @relation(fields: [inviteId], references: [id])
  items  SurveyItem[]

  @@index([memberId])
  @@map("survey_responses")
}

model SurveyItem {
  id            String  @id @default(uuid())
  responseId    String  @map("response_id")
  productId     String  @map("product_id")
  wouldBuyAgain Boolean @map("would_buy_again")
  comment       String?

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("survey_items")
}

/// An item a customer asked for that the store did not have (demand we lost).
model LostSale {
  id         String   @id @default(uuid())
  productId  String?  @map("product_id")
  itemText   String   @map("item_text")
  qty        Int      @default(1)
  memberId   String?  @map("member_id")
  locationId String   @map("location_id")
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by")

  @@index([productId, createdAt])
  @@index([locationId, createdAt])
  @@map("lost_sales")
}

/// A member reserves an item for pick-up at a branch.
model Reservation {
  id         String   @id @default(uuid())
  memberId   String   @map("member_id")
  productId  String   @map("product_id")
  qty        Int      @default(1)
  locationId String   @map("location_id")
  status     String   @default("REQUESTED") // REQUESTED | READY | PICKED_UP | CANCELLED
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  member Member @relation(fields: [memberId], references: [id])

  @@index([locationId, status])
  @@map("reservations")
}

/// "Tell me when it is available".
model StockAlertRequest {
  id         String    @id @default(uuid())
  memberId   String    @map("member_id")
  productId  String    @map("product_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  notifiedAt DateTime? @map("notified_at")

  @@index([productId, notifiedAt])
  @@map("stock_alert_requests")
}

/// Automatic messages already sent (one per key), so a reminder never goes twice.
model MemberAutoMessage {
  id       String   @id @default(uuid())
  kind     String
  key      String
  memberId String   @map("member_id")
  channel  String
  status   String
  sentAt   DateTime @default(now()) @map("sent_at")

  @@unique([kind, key])
  @@map("member_auto_messages")
}

/// A promo the Owner or the Head Auditor issues (owner request 2026-10-07): to every non-franchise branch, or separately to the franchises. Issuing also makes a memo.
model Promo {
  id            String    @id @default(uuid())
  title         String
  details       String
  audience      String // BRANCHES | FRANCHISES
  startsOn      DateTime  @map("starts_on") @db.Date
  endsOn        DateTime  @map("ends_on") @db.Date
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED
  memoId        String?   @map("memo_id")
  createdBy     String    @map("created_by")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")

  items PromoItem[]

  @@index([audience, status, endsOn])
  @@map("promos")
}

model PromoItem {
  id         String  @id @default(uuid())
  promoId    String  @map("promo_id")
  productId  String  @map("product_id")
  promoPrice Decimal @map("promo_price") @db.Decimal(14, 2)

  promo Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@unique([promoId, productId])
  @@index([productId])
  @@map("promo_items")
}

/// What happened when staff approached a customer from the Customer Service list (restock, birthday, win-back): how, whether they bought again, and if not, why (owner request 2026-10-07).
model CustomerContact {
  id            String    @id @default(uuid())
  kind          String // RESTOCK | BIRTHDAY | WINBACK | OTHER
  followUpId    String?   @map("follow_up_id")
  memberId      String?   @map("member_id")
  productId     String?   @map("product_id")
  locationId    String    @map("location_id")
  customerName  String?   @map("customer_name")
  phone         String?
  method        String // CALL | SMS | WHATSAPP | VIBER | MESSENGER | VISIT
  outcome       String // BOUGHT_AGAIN | WILL_BUY | NOT_BUYING | NO_ANSWER | WRONG_NUMBER | GREETED
  reason        String?
  note          String?
  recontactOn   DateTime? @map("recontact_on") @db.Date
  createdBy     String    @map("created_by")
  createdByName String?   @map("created_by_name")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([locationId, createdAt])
  @@index([memberId])
  @@index([followUpId])
  @@index([kind, outcome])
  @@map("customer_contacts")
}

/// Money moving because of a replacement's price difference (owner request 2026-10-08): the customer paid the difference, or it was refunded, on a day the
/// branch states. It shows on that day's Daily Sales Report as Replacement Payments, apart from normal sales. A closed day needs the Head Auditor.
model ReplacementPayment {
  id                String    @id @default(uuid())
  ticketId          String    @map("ticket_id")
  locationId        String    @map("location_id")
  businessDate      DateTime  @map("business_date") @db.Date
  direction         String // IN = the customer paid | OUT = refunded to the customer
  mode              String // CASH | ONLINE | CREDIT_CARD
  paymentAccountId  String?   @map("payment_account_id")
  amount            Decimal   @db.Decimal(14, 2)
  note              String?
  /// reference / approval number of the online or card payment, and the screenshot or slip (required for online and card; owner request 2026-10-09)
  reference         String?
  proofAttachmentId String?   @map("proof_attachment_id")
  status            String    @default("APPLIED") // APPLIED | PENDING_APPROVAL | REJECTED
  approvalRequestId String?   @map("approval_request_id")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  appliedAt         DateTime? @map("applied_at")

  @@index([locationId, businessDate, status])
  @@index([ticketId])
  @@map("replacement_payments")
}

/// A purchase order to one supplier (owner request 2026-10-08): the Head Auditor generates it from the days of stock of every branch, the Owner may change it and approves,
/// the supplier gets a copy without the branches, the Head Auditor / Owner / Warehouse In-Charge get copies with the branches, and the branches are told what to pull out.
model PurchaseOrder {
  id                String    @id @default(uuid())
  poNo              String    @unique @map("po_no")
  supplierId        String    @map("supplier_id")
  status            String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | SENT | PARTIAL | RECEIVED | CANCELLED
  basisDays         Int       @default(30) @map("basis_days") // days of sales the averages are taken from
  coverDays         Int       @default(30) @map("cover_days") // days of stock each branch should have after restocking
  reserveDays       Int       @default(7) @map("reserve_days") // days of stock the warehouse keeps for itself before giving stock to branches
  deliverToId       String?   @map("deliver_to_id")
  expectedOn        DateTime? @map("expected_on") @db.Date
  notes             String?
  approvalRequestId String?   @map("approval_request_id")
  createdBy         String    @map("created_by")
  createdByName     String?   @map("created_by_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  submittedAt       DateTime? @map("submitted_at")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  sentAt            DateTime? @map("sent_at")
  sentBy            String?   @map("sent_by")
  receivedAt        DateTime? @map("received_at")
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?   @map("cancel_reason")
  rejectNote        String?   @map("reject_note")

  lines PurchaseOrderLine[]

  @@index([supplierId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id           String  @id @default(uuid())
  poId         String  @map("po_id")
  productId    String  @map("product_id")
  whOnHand     Int     @default(0) @map("wh_on_hand")
  whAvgPerDay  Decimal @default(0) @map("wh_avg_per_day") @db.Decimal(10, 3)
  onOrder      Int     @default(0) @map("on_order") // already ordered and not yet received on other open POs
  suggestedQty Int     @default(0) @map("suggested_qty")
  orderQty     Int     @default(0) @map("order_qty")
  receivedQty  Int     @default(0) @map("received_qty")
  note         String?

  po   PurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  rows PurchaseOrderRow[]

  @@unique([poId, productId])
  @@map("purchase_order_lines")
}

/// One branch (or the warehouse) for one item: the stock and days left it has, what it needs, what to move to it from existing stock, and its share of the order.
model PurchaseOrderRow {
  id                String   @id @default(uuid())
  lineId            String   @map("line_id")
  locationId        String   @map("location_id")
  onHand            Int      @default(0) @map("on_hand")
  avgPerDay         Decimal  @default(0) @map("avg_per_day") @db.Decimal(10, 3)
  daysLeft          Decimal? @map("days_left") @db.Decimal(8, 1)
  need              Int      @default(0)
  suggestedTransfer Int      @default(0) @map("suggested_transfer")
  transferFromId    String?  @map("transfer_from_id")
  transferQty       Int      @default(0) @map("transfer_qty")
  suggestedAlloc    Int      @default(0) @map("suggested_alloc")
  allocQty          Int      @default(0) @map("alloc_qty")

  line PurchaseOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@unique([lineId, locationId])
  @@map("purchase_order_rows")
}
