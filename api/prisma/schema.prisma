// GWS-ERP Prisma schema — single data model for Phase 1 (operations) and Phase 2 (finance).
// Money: Decimal(14,2). Quantities: Int. Timestamps stored UTC; business dates computed in Asia/Manila.
// No hard deletes on transactional tables: voided_at / voided_by / void_reason.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Organisation ─────────────────────────────

enum LocationType {
  WAREHOUSE
  BRANCH
  FRANCHISE
  OFFICE
  CONSIGNEE
  VIRTUAL
}

model Location {
  id                   String       @id @default(uuid())
  code                 String       @unique
  name                 String
  type                 LocationType
  isSelling            Boolean      @default(false) @map("is_selling")
  franchiseOwnerUserId String?      @map("franchise_owner_user_id")
  address              String?
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now()) @map("created_at")
  createdBy            String?      @map("created_by")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  updatedBy            String?      @map("updated_by")

  franchiseOwner    User?                    @relation("FranchiseOwner", fields: [franchiseOwnerUserId], references: [id])
  assignments       UserLocationAssignment[]
  stockLedger       StockLedger[]
  stockBalances     StockBalance[]
  minStockLevels    MinStockLevel[]
  receivingDocs     ReceivingDoc[]
  transfersFrom     TransferDoc[]            @relation("TransferFrom")
  transfersTo       TransferDoc[]            @relation("TransferTo")
  salesDocs         SalesDoc[]
  expenseDocs       ExpenseDoc[]
  countDocs         CountDoc[]
  chargeForms       ChargeForm[]
  writeoffDocs      ExpiryWriteoffDoc[]
  consignmentsOut   ConsignmentAgreement[]   @relation("ConsigneeLocation")
  riders            Rider[]
  agents            Agent[]
  accounts          Account[]
  dailyCloses       DailyClose[]
  franchiseExpenses FranchiseExpense[]
  employees         Employee[]

  @@map("locations")
}

model Role {
  id          String   @id @default(uuid())
  key         String   @unique // ADMIN, HEAD_AUDITOR, ...
  name        String
  description String?
  permissions Json // string[] of permission keys
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id                       String    @id @default(uuid())
  username                 String    @unique
  email                    String    @unique
  fullName                 String    @map("full_name")
  roleId                   String    @map("role_id")
  passwordHash             String    @map("password_hash")
  totpSecret               String?   @map("totp_secret")
  totpEnabled              Boolean   @default(false) @map("totp_enabled")
  active                   Boolean   @default(true)
  mustChangePassword       Boolean   @default(true) @map("must_change_password")
  /// Company ID number of the one person this account belongs to (accounts are personal, never shared).
  idNumber                 String?   @unique @map("id_number")
  /// When the person accepted the accountability statement ("this account is mine; everything done under it is my responsibility").
  accountabilityAcceptedAt DateTime? @map("accountability_accepted_at")
  accountabilityIp         String?   @map("accountability_ip")
  emailDigest              Boolean   @default(true) @map("email_digest")
  lastLoginAt              DateTime? @map("last_login_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  createdBy                String?   @map("created_by")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  updatedBy                String?   @map("updated_by")

  role                Role                     @relation(fields: [roleId], references: [id])
  assignments         UserLocationAssignment[]
  permissionOverrides UserPermissionOverride[]
  ownedFranchises     Location[]               @relation("FranchiseOwner")
  notifications       Notification[]
  approvalDecisions   ApprovalDecision[]
  auditLogs           AuditLog[]
  employee            Employee?

  @@map("users")
}

model UserLocationAssignment {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  locationId String   @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@map("user_location_assignments")
}

model UserPermissionOverride {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  permissionKey String   @map("permission_key")
  granted       Boolean // true = grant, false = revoke
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@map("user_permission_overrides")
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique // SUP-001 — visible to everyone
  name        String // Admin / Head Auditor / External Auditor only (redacted otherwise)
  contact     String?
  termsDays   Int      @default(0) @map("terms_days")
  apAccountId String?  @map("ap_account_id")
  isConsignor Boolean  @default(false) @map("is_consignor")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  apAccount      Account?               @relation(fields: [apAccountId], references: [id])
  products       Product[]
  batches        Batch[]
  receivingDocs  ReceivingDoc[]
  consignmentsIn ConsignmentAgreement[] @relation("ConsignorSupplier")

  @@map("suppliers")
}

enum AccountingClass {
  SUPPLEMENT
  FREEBIE
  PLASTIC
  APPAREL
  EQUIPMENT
  OTHER
  REPACKED
  BUNDLE
}

model Category {
  id              String          @id @default(uuid())
  name            String          @unique
  accountingClass AccountingClass @map("accounting_class")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  barcode          String?  @unique
  name             String
  categoryId       String   @map("category_id")
  brand            String?
  unit             String   @default("pc")
  supplierId       String?  @map("supplier_id")
  trackExpiry      Boolean  @default(true) @map("track_expiry")
  active           Boolean  @default(true)
  isBundle         Boolean  @default(false) @map("is_bundle")
  franchiseVisible Boolean  @default(true) @map("franchise_visible")
  needsReview      Boolean  @default(false) @map("needs_review") // flagged by import keyword map
  createdAt        DateTime @default(now()) @map("created_at")
  createdBy        String?  @map("created_by")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  category             Category              @relation(fields: [categoryId], references: [id])
  supplier             Supplier?             @relation(fields: [supplierId], references: [id])
  bundleComponents     BundleComponent[]     @relation("BundleParent")
  componentOf          BundleComponent[]     @relation("BundleChild")
  prices               PriceList[]
  costs                ProductCost[]
  minStockLevels       MinStockLevel[]
  batches              Batch[]
  stockLedger          StockLedger[]
  stockBalances        StockBalance[]
  receivingLines       ReceivingLine[]
  transferLines        TransferLine[]
  salesLines           SalesLine[]
  countLines           CountLine[]
  chargeFormLines      ChargeFormLine[]
  writeoffLines        ExpiryWriteoffLine[]
  priceChangeLines     PriceChangeLine[]
  consignmentSaleLines ConsignmentSaleLine[]

  @@index([name])
  @@map("products")
}

model BundleComponent {
  id                 String @id @default(uuid())
  bundleProductId    String @map("bundle_product_id")
  componentProductId String @map("component_product_id")
  qty                Int

  bundle    Product @relation("BundleParent", fields: [bundleProductId], references: [id])
  component Product @relation("BundleChild", fields: [componentProductId], references: [id])

  @@unique([bundleProductId, componentProductId])
  @@map("bundle_components")
}

model PriceTier {
  id        String   @id @default(uuid())
  key       String   @unique // RETAIL, DEALER, FRANCHISE, AGENT, WHOLESALE, OTHER_1...
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("price_tiers")
}

model PriceList {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  tier          String // PriceTier.key
  effectiveFrom DateTime @map("effective_from") @db.Date
  price         Decimal  @db.Decimal(14, 2)
  approvedBy    String?  @map("approved_by")
  sourceDocId   String?  @map("source_doc_id")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, tier, effectiveFrom])
  @@index([productId, tier])
  @@map("price_lists")
}

model ProductCost {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  cost          Decimal  @db.Decimal(14, 2)
  approvedBy    String?  @map("approved_by")
  sourceDocId   String?  @map("source_doc_id")
  createdAt     DateTime @default(now()) @map("created_at")
  createdBy     String?  @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, effectiveFrom])
  @@map("product_costs")
}

model MinStockLevel {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  minQty     Int      @map("min_qty")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("min_stock_levels")
}

// ───────────────────────────── Stock ─────────────────────────────

model Batch {
  id               String    @id @default(uuid())
  productId        String    @map("product_id")
  batchNo          String?   @map("batch_no")
  expiryDate       DateTime? @map("expiry_date") @db.Date
  receivedRef      String?   @map("received_ref") // receiving doc id / opening stock ref
  unitCost         Decimal   @map("unit_cost") @db.Decimal(14, 2)
  originalUnitCost Decimal?  @map("original_unit_cost") @db.Decimal(14, 2) // kept when revalued (R12)
  supplierId       String?   @map("supplier_id")
  isConsignmentIn  Boolean   @default(false) @map("is_consignment_in")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  product       Product              @relation(fields: [productId], references: [id])
  supplier      Supplier?            @relation(fields: [supplierId], references: [id])
  ledger        StockLedger[]
  balances      StockBalance[]
  transferLines TransferLine[]
  salesLines    SalesLine[]
  writeoffLines ExpiryWriteoffLine[]
  revaluations  RevaluationLine[]

  @@index([productId, expiryDate])
  @@map("batches")
}

enum MovementType {
  RECEIVE
  TRANSFER_OUT
  TRANSFER_IN
  SALE
  SALE_RETURN
  RETURN_TO_WAREHOUSE
  RETURN_TO_SUPPLIER
  CONSIGN_OUT
  CONSIGN_SALE
  CONSIGN_RETURN
  ADJUST_COUNT
  EXPIRED_WRITEOFF
  FREEBIE_ISSUE
  TASTING
  BUNDLE_BUILD
  BUNDLE_BREAK
}

model StockLedger {
  id           String       @id @default(uuid())
  locationId   String       @map("location_id")
  productId    String       @map("product_id")
  batchId      String       @map("batch_id")
  qtyDelta     Int          @map("qty_delta")
  movementType MovementType @map("movement_type")
  documentType String       @map("document_type")
  documentId   String       @map("document_id")
  unitCost     Decimal      @map("unit_cost") @db.Decimal(14, 2) // batch cost at time of movement
  postedAt     DateTime     @default(now()) @map("posted_at")
  businessDate DateTime     @map("business_date") @db.Date // Manila calendar date
  createdBy    String?      @map("created_by")

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@index([locationId, productId])
  @@index([documentType, documentId])
  @@index([businessDate])
  @@map("stock_ledger")
}

model StockBalance {
  locationId String   @map("location_id")
  productId  String   @map("product_id")
  batchId    String   @map("batch_id")
  qty        Int
  updatedAt  DateTime @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    Batch    @relation(fields: [batchId], references: [id])

  @@id([locationId, productId, batchId])
  @@index([locationId, productId])
  @@map("stock_balances")
}

// ───────────────────────────── Documents ─────────────────────────────

enum DocStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  VOIDED
}

model ControlSequence {
  id       String @id @default(uuid())
  docType  String @map("doc_type")
  scopeKey String @default("") @map("scope_key") // location id or '' (NULLs would defeat ON CONFLICT)
  year     Int    @default(0)
  nextNo   Int    @default(1) @map("next_no")

  @@unique([docType, scopeKey, year])
  @@map("control_sequences")
}

model Attachment {
  id           String   @id @default(uuid())
  documentType String   @map("document_type")
  documentId   String   @map("document_id")
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key")
  sha256       String
  scanStatus   String   @default("CLEAN") @map("scan_status") // CLEAN | SKIPPED | INFECTED
  uploadedBy   String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([documentType, documentId])
  @@map("attachments")
}

model ReceivingDoc {
  id                String    @id @default(uuid())
  controlNo         String    @map("control_no")
  docDate           DateTime  @map("doc_date") @db.Date
  status            DocStatus @default(DRAFT)
  locationId        String    @map("location_id")
  supplierId        String    @map("supplier_id")
  supplierRef       String?   @map("supplier_ref")
  isConsignmentIn   Boolean   @default(false) @map("is_consignment_in")
  paidOnReceipt     Boolean   @default(false) @map("paid_on_receipt")
  paymentAccountId  String?   @map("payment_account_id")
  notes             String?
  preparedBy        String    @map("prepared_by")
  approvalRequestId String?   @map("approval_request_id")
  postedAt          DateTime? @map("posted_at")
  voidedAt          DateTime? @map("voided_at")
  voidedBy          String?   @map("voided_by")
  voidReason        String?   @map("void_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  createdBy         String?   @map("created_by")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  updatedBy         String?   @map("updated_by")

  location Location        @relation(fields: [locationId], references: [id])
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  lines    ReceivingLine[]

  @@unique([locationId, controlNo])
  @@map("receiving_docs")
}

model ReceivingLine {
  id            String    @id @default(uuid())
  docId         String    @map("doc_id")
  productId     String    @map("product_id")
  qty           Int
  freeQty       Int       @default(0) @map("free_qty")
  expiryDate    DateTime? @map("expiry_date") @db.Date
  batchNo       String?   @map("batch_no")
  unitCost      Decimal?  @map("unit_cost") @db.Decimal(14, 2) // entered by Head Auditor; hidden from warehouse roles
  costUnchanged Boolean   @default(false) @map("cost_unchanged")
  isNewProduct  Boolean   @default(false) @map("is_new_product")
  batchId       String?   @map("batch_id")
  remarks       String?

  doc     ReceivingDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("receiving_lines")
}

enum TransferType {
  RESTOCK
  RETURN
  REPLACEMENT
  CONSIGNMENT_OUT
  CONSIGNMENT_RETURN
  INTERNAL
}

enum TransferStatus {
  DRAFT
  SUBMITTED
  APPROVED // stock moved to IN_TRANSIT
  REJECTED
  RECEIVED // fully confirmed
  DISCREPANCY // received with shortfall pending Head Auditor resolution
  RESOLVED
  VOIDED
}

model TransferDoc {
  id                String         @id @default(uuid())
  controlNo         String         @map("control_no")
  docDate           DateTime       @map("doc_date") @db.Date
  status            TransferStatus @default(DRAFT)
  fromLocationId    String         @map("from_location_id")
  toLocationId      String         @map("to_location_id")
  transferType      TransferType   @map("transfer_type")
  returnReason      String?        @map("return_reason") // clumped, damaged, wrong item, expired
  notes             String?
  preparedBy        String         @map("prepared_by")
  approvalRequestId String?        @map("approval_request_id")
  approvedAt        DateTime?      @map("approved_at")
  receivedBy        String?        @map("received_by")
  receivedAt        DateTime?      @map("received_at")
  discrepancyCaseId String?        @map("discrepancy_case_id")
  voidedAt          DateTime?      @map("voided_at")
  voidedBy          String?        @map("voided_by")
  voidReason        String?        @map("void_reason")
  createdAt         DateTime       @default(now()) @map("created_at")
  createdBy         String?        @map("created_by")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  updatedBy         String?        @map("updated_by")

  fromLocation Location       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   Location       @relation("TransferTo", fields: [toLocationId], references: [id])
  lines        TransferLine[]

  @@unique([fromLocationId, controlNo])
  @@index([toLocationId, status])
  @@map("transfer_docs")
}

model TransferLine {
  id                  String  @id @default(uuid())
  docId               String  @map("doc_id")
  productId           String  @map("product_id")
  batchId             String  @map("batch_id")
  qtySent             Int     @map("qty_sent")
  qtyReceived         Int?    @map("qty_received")
  checkerRemarks      String? @map("checker_remarks")
  discrepancyNote     String? @map("discrepancy_note")
  shortfallResolution String? @map("shortfall_resolution") // TO_SENDER | TO_RECEIVER | WRITEOFF

  doc     TransferDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  batch   Batch       @relation(fields: [batchId], references: [id])

  @@map("transfer_lines")
}

enum SalesChannel {
  WALK_IN
  DELIVERY
  SHIPPING_COURIER
  SHIPPING_MARKETPLACE
  FRANCHISE
  DEALER
  AGENT
  PERSONAL
  OTHER
}

enum PaymentMode {
  CASH
  ONLINE
  CREDIT_CARD
  AR_PDC
}

enum CustomerType {
  DEALER
  FRANCHISE
  AGENT
  CONSIGNEE
  CUSTOMER
}

model Customer {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  type        CustomerType
  locationId  String?      @map("location_id") // FRANCHISE/CONSIGNEE customers map to a Location
  agentId     String?      @map("agent_id")
  arAccountId String?      @map("ar_account_id")
  contact     String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  createdBy   String?      @map("created_by")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  arAccount  Account?   @relation(fields: [arAccountId], references: [id])
  salesDocs  SalesDoc[]
  arPayments Payment[]

  @@map("customers")
}

model Agent {
  id          String   @id @default(uuid())
  name        String
  locationId  String   @map("location_id")
  onPayroll   Boolean  @default(false) @map("on_payroll")
  defaultTier String   @default("AGENT") @map("default_tier")
  employeeId  String?  @map("employee_id")
  arAccountId String?  @map("ar_account_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  location  Location   @relation(fields: [locationId], references: [id])
  arAccount Account?   @relation(fields: [arAccountId], references: [id])
  salesDocs SalesDoc[]

  @@map("agents")
}

model Rider {
  id         String   @id @default(uuid())
  name       String
  locationId String   @map("location_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  location  Location   @relation(fields: [locationId], references: [id])
  salesDocs SalesDoc[]

  @@map("riders")
}

model SalesDoc {
  id                         String       @id @default(uuid())
  controlNo                  String       @map("control_no")
  docDate                    DateTime     @map("doc_date") @db.Date
  status                     DocStatus    @default(POSTED) // sales post to stock immediately
  locationId                 String       @map("location_id")
  channel                    SalesChannel
  channelSub                 String?      @map("channel_sub") // e.g. CONSIGNMENT, SHOPEE, LAZADA, TIKTOK
  customerId                 String?      @map("customer_id")
  agentId                    String?      @map("agent_id")
  riderId                    String?      @map("rider_id")
  customerName               String?      @map("customer_name")
  drSiNo                     String       @map("dr_si_no")
  paymentMode                PaymentMode  @map("payment_mode")
  paymentAccountId           String?      @map("payment_account_id")
  proofOfPaymentAttachmentId String?      @map("proof_of_payment_attachment_id")
  cardMid                    String?      @map("card_mid")
  cardSlipNo                 String?      @map("card_slip_no")
  cardApprovalCode           String?      @map("card_approval_code")
  cardBatchNo                String?      @map("card_batch_no")
  deliveryFee                Decimal      @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  riderIncentive             Decimal      @default(0) @map("rider_incentive") @db.Decimal(14, 2)
  shippingFee                Decimal      @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  shippingExpense            Decimal      @default(0) @map("shipping_expense") @db.Decimal(14, 2)
  marketplaceCharges         Decimal      @default(0) @map("marketplace_charges") @db.Decimal(14, 2)
  productTotal               Decimal      @default(0) @map("product_total") @db.Decimal(14, 2)
  grandTotal                 Decimal      @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid                 Decimal      @default(0) @map("amount_paid") @db.Decimal(14, 2)
  dueDate                    DateTime?    @map("due_date") @db.Date
  pdcBank                    String?      @map("pdc_bank")
  pdcChequeNo                String?      @map("pdc_cheque_no")
  pdcDate                    DateTime?    @map("pdc_date") @db.Date
  notes                      String?
  preparedBy                 String       @map("prepared_by")
  specialPriceApprovalId     String?      @map("special_price_approval_id")
  specialPriceStatus         String?      @map("special_price_status") // PENDING | APPROVED | REJECTED
  discrepancyCaseId          String?      @map("discrepancy_case_id")
  voidedAt                   DateTime?    @map("voided_at")
  voidedBy                   String?      @map("voided_by")
  voidReason                 String?      @map("void_reason")
  createdAt                  DateTime     @default(now()) @map("created_at")
  createdBy                  String?      @map("created_by")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  updatedBy                  String?      @map("updated_by")

  location       Location            @relation(fields: [locationId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  agent          Agent?              @relation(fields: [agentId], references: [id])
  rider          Rider?              @relation(fields: [riderId], references: [id])
  paymentAccount Account?            @relation(fields: [paymentAccountId], references: [id])
  lines          SalesLine[]
  payments       PaymentAllocation[]

  @@unique([locationId, drSiNo])
