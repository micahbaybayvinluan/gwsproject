# ---- API ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://gws:gws@localhost:5432/gws?schema=public
REDIS_URL=redis://localhost:6379
SESSION_COOKIE=gws_sid
SESSION_SECRET=change-me
# Development / simulation only: lets Admin, auditors and Accounting Head log in without an authenticator app. MUST be false in production.
AUTH_TOTP_OPTIONAL=true
APP_TIMEZONE=Asia/Manila
FISCAL_YEAR_START=2026-01-01
# object storage: leave S3_ENDPOINT empty to store uploads on local disk (api/uploads); set to MinIO/S3 in production
S3_ENDPOINT=
S3_REGION=ap-southeast-1
S3_BUCKET=gws-attachments
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true
# ClamAV (clamd INSTREAM)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
# PDF rendering: leave empty to use the installed Google Chrome / Edge / Chromium automatically
PUPPETEER_EXECUTABLE_PATH=
# email digest (optional)
SMTP_URL=
MAIL_FROM=noreply@gws.local
# ---- WEB ----
VITE_API_URL=http://localhost:4000
# Help assistant (optional): with a key, the "Ask" box on Help & Guide answers questions with Claude, using docs/USER-GUIDE.md.
# Leave empty to answer from the guide only. Get a key at console.anthropic.com (billed per question).
ANTHROPIC_API_KEY=
HELP_AI_MODEL=claude-opus-5
HELP_AI_PER_HOUR=30

# Customer re-order SMS (optional): a Semaphore (semaphore.co) API key and approved sender name
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
