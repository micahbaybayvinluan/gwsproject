}

model SalesDoc {
  id                         String       @id @default(uuid())
  controlNo                  String       @map("control_no")
  docDate                    DateTime     @map("doc_date") @db.Date
  status                     DocStatus    @default(POSTED) // sales post to stock immediately
  locationId                 String       @map("location_id")
  channel                    SalesChannel
  channelSub                 String?      @map("channel_sub") // e.g. CONSIGNMENT, SHOPEE, LAZADA, TIKTOK
  customerId                 String?      @map("customer_id")
  agentId                    String?      @map("agent_id")
  /// the agent's outlet / gym this sale is tagged to (owner request 2026-10-02): the agent sees the orders of their outlets
  outletId                   String?      @map("outlet_id")
  /// the Wheysted member this sale belongs to (owner request 2026-10-03)
  memberId                   String?      @map("member_id")
  /// a member's voucher used on this sale and the discount it gave
  voucherId                  String?      @map("voucher_id")
  voucherDiscount            Decimal      @default(0) @map("voucher_discount") @db.Decimal(14, 2)
  riderId                    String?      @map("rider_id")
  customerName               String?      @map("customer_name")
  /// walk-in / online customer contact details captured at the sale (for the customer contact list)
  customerPhone              String?      @map("customer_phone")
  customerEmail              String?      @map("customer_email")
  drSiNo                     String       @map("dr_si_no")
  paymentMode                PaymentMode  @map("payment_mode")
  paymentAccountId           String?      @map("payment_account_id")
  proofOfPaymentAttachmentId String?      @map("proof_of_payment_attachment_id")
  cardMid                    String?      @map("card_mid")
  cardSlipNo                 String?      @map("card_slip_no")
  cardApprovalCode           String?      @map("card_approval_code")
  cardBatchNo                String?      @map("card_batch_no")
  /// stickers given on this sale for the 6-Pack Card (owner request 2026-09-30)
  sixPackStickers            Int          @default(0) @map("six_pack_stickers")
  deliveryFee                Decimal      @default(0) @map("delivery_fee") @db.Decimal(14, 2)
  riderIncentive             Decimal      @default(0) @map("rider_incentive") @db.Decimal(14, 2)
  // incentive paid out of this sale's cash (owner request 2026-09-27): a branch expense deducted from the cash to remit
  incentiveAmount            Decimal      @default(0) @map("incentive_amount") @db.Decimal(14, 2)
  incentivePayee             String?      @map("incentive_payee")
  incentiveExpenseId         String?      @map("incentive_expense_id")
  shippingFee                Decimal      @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  shippingExpense            Decimal      @default(0) @map("shipping_expense") @db.Decimal(14, 2)
  marketplaceCharges         Decimal      @default(0) @map("marketplace_charges") @db.Decimal(14, 2)
  productTotal               Decimal      @default(0) @map("product_total") @db.Decimal(14, 2)
  grandTotal                 Decimal      @default(0) @map("grand_total") @db.Decimal(14, 2)
  amountPaid                 Decimal      @default(0) @map("amount_paid") @db.Decimal(14, 2)
  dueDate                    DateTime?    @map("due_date") @db.Date
  pdcBank                    String?      @map("pdc_bank")
  pdcChequeNo                String?      @map("pdc_cheque_no")
  pdcDate                    DateTime?    @map("pdc_date") @db.Date
  notes                      String?
  preparedBy                 String       @map("prepared_by")
  specialPriceApprovalId     String?      @map("special_price_approval_id")
  specialPriceStatus         String?      @map("special_price_status") // PENDING | APPROVED | REJECTED
  discrepancyCaseId          String?      @map("discrepancy_case_id")
  voidedAt                   DateTime?    @map("voided_at")
  voidedBy                   String?      @map("voided_by")
  voidReason                 String?      @map("void_reason")
  createdAt                  DateTime     @default(now()) @map("created_at")
  createdBy                  String?      @map("created_by")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  updatedBy                  String?      @map("updated_by")

  location       Location            @relation(fields: [locationId], references: [id])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  agent          Agent?              @relation(fields: [agentId], references: [id])
  outlet         Outlet?             @relation(fields: [outletId], references: [id])
  member         Member?             @relation(fields: [memberId], references: [id])
  rider          Rider?              @relation(fields: [riderId], references: [id])
  paymentAccount Account?            @relation(fields: [paymentAccountId], references: [id])
  lines          SalesLine[]
  payments       PaymentAllocation[]

  @@unique([locationId, drSiNo])
  @@index([locationId, docDate])
  @@index([paymentMode, dueDate])
  @@map("sales_docs")
}

model SalesLine {
  id               String  @id @default(uuid())
  docId            String  @map("doc_id")
  productId        String  @map("product_id")
  batchId          String  @map("batch_id")
  qty              Int
  priceTier        String  @map("price_tier")
  tierPrice        Decimal @map("tier_price") @db.Decimal(14, 2) // tier price at time of sale
  unitPrice        Decimal @map("unit_price") @db.Decimal(14, 2)
  unitCost         Decimal @map("unit_cost") @db.Decimal(14, 2) // batch cost snapshot (redacted by role)
