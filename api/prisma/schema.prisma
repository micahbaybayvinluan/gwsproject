  appliesTo    String       @default("BRANCH") @map("applies_to") // BRANCH | FRANCHISE | BOTH
  sortOrder    Int          @default(0) @map("sort_order")

  accounts Account[]

  @@map("account_templates")
}

model Account {
  id                 String              @id @default(uuid())
  code               String              @unique
  title              String
  class              AccountClass
  normalBalance      NormalBalance       @map("normal_balance")
  branchTagId        String?             @map("branch_tag_id")
  channelTag         String?             @map("channel_tag")
  entryScope         EntryScope          @default(MAIN) @map("entry_scope")
  isPaymentAccount   Boolean             @default(false) @map("is_payment_account")
  paymentAccountType PaymentAccountType? @map("payment_account_type")
  counterpartyType   String?             @map("counterparty_type") // DEALER | FRANCHISE | AGENT | SUPPLIER | CONSIGNEE | EMPLOYEE
  counterpartyId     String?             @map("counterparty_id")
  templateId         String?             @map("template_id")
  parentCode         String?             @map("parent_code")
  sortOrder          Int                 @default(0) @map("sort_order")
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now()) @map("created_at")
  createdBy          String?             @map("created_by")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  updatedBy          String?             @map("updated_by")

  branchTag         Location?          @relation(fields: [branchTagId], references: [id])
  template          AccountTemplate?   @relation(fields: [templateId], references: [id])
  journalLines      JournalLine[]
  expenseDocs       ExpenseDoc[]       @relation("ExpenseAccount")
  expensePaidFrom   ExpenseDoc[]       @relation("ExpensePaidFrom")
  salesDocs         SalesDoc[]
  payments          Payment[]
  cashDeposits      CashDeposit[]
  suppliers         Supplier[]
  customers         Customer[]
  agents            Agent[]
  fixedAssets       FixedAsset[]       @relation("AssetAccount")
  accumDepnFor      FixedAsset[]       @relation("AccumDepnAccount")
  beginningBalances BeginningBalance[]

  @@index([class])
  @@index([branchTagId])
  @@map("accounts")
}

enum Book {
  BENTA
  GENERAL
  ADVANCES
  GASTOS_OPEX
  GASTOS_DC
}

model JournalVoucher {
